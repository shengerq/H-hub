<resources>
    <style name="HubThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0067c0</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#f7f8fa</item>
        <item name="android:statusBarColor">#f7f8fa</item>
        <item name="android:navigationBarColor">#f7f8fa</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="HubThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0067c0</item>
        <item name="android:windowBackground">#131820</item>
        <item name="android:statusBarColor">#131820</item>
        <item name="android:navigationBarColor">#131820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
