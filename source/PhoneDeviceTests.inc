test(L"Phone device read works without a saved scene payload and queues the desktop adapter",[&]{
 Model m({},false);auto plugin=object(LR"({"id":"phone-rapoo","name":"Rapoo","installed":true,"mode":"auto","ui":{"type":"offline-html","content":"function liveKeys(){if(!liveBaseline){};const liveDevice=new RapooProtocol.Device();"},"hidTargets":[{"vid":9390,"pid":5153}]})");m.state.GetNamedArray(L"plugins").Append(plugin);
 m.state.SetNamedValue(L"detected",object(LR"({"peripherals":[{"id":"mouse-live","name":"Mouse","kind":"mouse","vid":9390,"pid":5153,"containerId":"physical-one","connected":true}]})"));m.state.SetNamedValue(L"phoneRuntime",object(LR"({"running":true,"phones":[{"id":"peer","control":true}]})"));
 m.requestPhoneDevice(object(LR"({"kind":"deviceRead","id":"mouse-live","deviceId":"peer"})"));auto job=m.state.GetNamedArray(L"phoneDeviceControls").GetObjectAt(0);ensure(str(job,L"state")==L"waiting"&&m.state.GetNamedArray(L"deviceProfiles").Size()==0);
 auto worker=m.request(object(LR"({"op":"deviceProfileWorkerState","body":{}})"));ensure(flag(worker.GetNamedObject(L"state"),L"registered")&&worker.GetNamedObject(L"state").GetNamedArray(L"plugins").GetStringAt(0)==L"phone-rapoo");
 JsonObject b;put(b,L"requestId",str(job,L"requestId"));put(b,L"plugin",std::wstring(L"phone-rapoo"));m.phoneDeviceWorkerRequest(L"phoneDeviceValidate",b);put(b,L"confirmed",true);b.SetNamedValue(L"payload",object(LR"({"config":{"stages":[800,1600],"axisY":[800,1600],"selected":0,"polling":1000,"privateMacro":"do-not-expose"}})"));m.phoneDeviceWorkerRequest(L"phoneDeviceAck",b);
 auto view=phoneView(m.state);auto d=view.GetNamedArray(L"devices").GetObjectAt(0);ensure(flag(d,L"canConfigure")&&str(d.GetNamedObject(L"configuration"),L"state")==L"confirmed");ensure(num(d.GetNamedObject(L"configuration").GetNamedObject(L"values"),L"dpi")==800);ensure(std::wstring(view.Stringify()).find(L"do-not-expose")==std::wstring::npos);
 bool denied=false;try{m.phoneDeviceWorkerRequest(L"phoneDeviceAck",b);}catch(...){denied=true;}ensure(denied);
});
test(L"Phone parameter writes reject invalid fields, mismatched readback and revoked authority",[&]{
 Model m({},false);m.state.GetNamedArray(L"plugins").Append(object(LR"({"id":"phone-rapoo","name":"Rapoo","installed":true,"mode":"auto","ui":{"type":"offline-html","content":"function liveKeys(){if(!liveBaseline){};new RapooProtocol.Device();"},"hidTargets":[{"vid":9390,"pid":5153}]})"));m.state.SetNamedValue(L"detected",object(LR"({"peripherals":[{"id":"mouse-live","kind":"mouse","vid":9390,"pid":5153,"connected":true}]})"));m.state.SetNamedValue(L"phoneRuntime",object(LR"({"running":true,"phones":[{"id":"peer","control":true}]})"));
 for(auto invalid:{LR"({"dpi":0})",LR"({"dpi":801})",LR"({"polling":1234})",LR"({"factoryReset":true})",LR"({"dpi":800,"polling":1000})"}){bool denied=false;try{phoneValidateControlPatch(object(invalid));}catch(...){denied=true;}ensure(denied);}
 m.requestPhoneDevice(object(LR"({"kind":"deviceWrite","id":"mouse-live","deviceId":"peer","patch":{"dpi":1600}})"));auto job=m.state.GetNamedArray(L"phoneDeviceControls").GetObjectAt(0);JsonObject b;put(b,L"requestId",str(job,L"requestId"));put(b,L"plugin",std::wstring(L"wrong-plugin"));bool denied=false;try{m.phoneDeviceWorkerRequest(L"phoneDeviceValidate",b);}catch(...){denied=true;}ensure(denied);
 put(b,L"plugin",std::wstring(L"phone-rapoo"));m.phoneDeviceWorkerRequest(L"phoneDeviceValidate",b);put(b,L"confirmed",true);b.SetNamedValue(L"payload",object(LR"({"config":{"stages":[800],"axisY":[800],"selected":0,"polling":1000}})"));denied=false;try{m.phoneDeviceWorkerRequest(L"phoneDeviceAck",b);}catch(...){denied=true;}ensure(denied&&str(job,L"state")!=L"confirmed");
 put(m.state.GetNamedObject(L"phoneRuntime").GetNamedArray(L"phones").GetObjectAt(0),L"control",false);denied=false;try{m.phoneDeviceWorkerRequest(L"phoneDeviceValidate",b);}catch(...){denied=true;}ensure(denied);m.expirePhoneDeviceJobs();ensure(str(job,L"state")==L"failed");
});
test(L"Legacy phone adapter rejects multiple identical physical mice",[&]{Model m({},false);m.state.GetNamedArray(L"plugins").Append(object(LR"({"id":"phone-rapoo","installed":true,"mode":"auto","ui":{"type":"offline-html","content":"function liveKeys(){if(!liveBaseline){};new RapooProtocol.Device();"},"hidTargets":[{"vid":9390,"pid":5153}]})"));auto devices=object(LR"({"peripherals":[{"id":"a","kind":"mouse","vid":9390,"pid":5153},{"id":"b","kind":"mouse","vid":9390,"pid":5153}]})");m.state.SetNamedValue(L"detected",devices);bool denied=false;try{phoneControlPlugin(m.state,devices.GetNamedArray(L"peripherals").GetObjectAt(0));}catch(...){denied=true;}ensure(denied);});
