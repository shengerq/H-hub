std::wstring catalogDeviceLabel(JsonObject p){if(!p.HasKey(L"compatibility"))return L"设备与固件信息待补充";auto c=p.GetNamedObject(L"compatibility");if(str(c,L"scope")==L"tool")return L"开发工具 · 不参与设备匹配";std::wstring firmware;for(auto const& v:c.GetNamedArray(L"firmwareVersions",JsonArray{})){if(!firmware.empty())firmware+=L"、";firmware+=std::wstring(v.GetString());}return str(c,L"deviceName")+L" · "+str(c,L"hardwareId")+L" · 固件："+(firmware.empty()?L"待确认":firmware);}
std::wstring catalogTrustLabel(JsonObject p){auto c=p.GetNamedObject(L"compatibility",JsonObject{});return (str(p,L"verificationStatus")==L"verified"?std::wstring(L"实机已验证"):std::wstring(L"实机待验证"))+L" · "+(flag(c,L"mobileUi")?(flag(p,L"mobileUiVerified")?L"手机 UI 已验证":L"声明支持手机 UI · 待验收"):L"未声明支持手机 UI");}
bool pluginMatches(JsonObject p){if(pluginQuery.empty())return true;auto hay=str(p,L"name")+L" "+str(p,L"id")+L" "+str(p,L"author")+L" "+str(p,L"description")+L" "+catalogDeviceLabel(p)+L" "+str(p,L"identityCode")+std::wstring(p.GetNamedArray(L"tags",JsonArray{}).Stringify());auto fold=[](std::wstring s){for(auto& c:s)c=(wchar_t)towlower(c);return s;};return fold(hay).find(fold(pluginQuery))!=std::wstring::npos;}
void updateCatalogList(){if(!catalogItems)return;catalogItems.Children().Clear();unsigned count=0;for(auto const& value:catalogFeed.GetNamedArray(L"plugins",JsonArray{})){auto p=value.GetObject();if(!pluginMatches(p))continue;auto row=stack(false,8);auto heading=stack(true,12);heading.Children().Append(title(str(p,L"name"),17));heading.Children().Append(text(L"v"+str(p,L"version"),12,true));row.Children().Append(heading);row.Children().Append(text(catalogDeviceLabel(p),12,true));row.Children().Append(text(str(p,L"description"),13,true));row.Children().Append(text(str(p,L"author"),12,true));row.Children().Append(text(catalogTrustLabel(p),12,true));row.Children().Append(text(str(p,L"identityCode").empty()?L"唯一编码待补充":str(p,L"identityCode"),11,true));bool installed=false;std::wstring installedVersion;for(auto const& v:state.GetNamedArray(L"plugins")){auto current=v.GetObject();if(str(current,L"id")==str(p,L"id")&&flag(current,L"installed")){installed=true;installedVersion=str(current,L"version");}}auto action=button(installed&&installedVersion==str(p,L"version")?L"已安装":installed?L"下载更新":L"下载并安装",[this,p]{downloadCatalogPlugin(p);},!installed);action.IsEnabled(!catalogBusy&&!(installed&&installedVersion==str(p,L"version"))&&!str(catalogFeed,L"indexUrl").empty());catalogItems.Children().Append(card(actionHeader(row,action),14));++count;}if(!count)catalogItems.Children().Append(text(pluginQuery.empty()?L"插件库暂无插件":L"没有匹配的插件",13,true));for(auto const& [tile,p]:installedPluginTiles)tile.Visibility(pluginMatches(p)?Visibility::Visible:Visibility::Collapsed);}
void pluginCatalogPanel(){if(!catalogFeed)catalogFeed=cachedCatalog();auto config=catalogConfig();auto body=stack(false,10);body.Children().Append(title(L"H hub插件库",20));auto row=stack(true,10);catalogSearch=TextBox{};catalogSearch.Width(320);catalogSearch.PlaceholderText(L"搜索插件、外设型号或作者");catalogSearch.Text(pluginQuery);Microsoft::UI::Xaml::Automation::AutomationProperties::SetName(catalogSearch,L"搜索插件");onTextChanged(catalogSearch,[this](auto const&,auto const&){pluginQuery=std::wstring(catalogSearch.Text());updateCatalogList();});row.Children().Append(catalogSearch);catalogRepository=TextBox{};catalogRepository.Width(300);catalogRepository.PlaceholderText(L"GitHub 用户名/H-hub-plugins");catalogRepository.Text(str(config,L"repository"));Microsoft::UI::Xaml::Automation::AutomationProperties::SetName(catalogRepository,L"GitHub 插件库仓库");row.Children().Append(catalogRepository);auto sync=button(catalogBusy?L"正在同步…":L"同步插件库",[this]{syncCatalog();},true);sync.IsEnabled(!catalogBusy);row.Children().Append(sync);body.Children().Append(row);body.Children().Append(text(catalogMessage.empty()?(str(config,L"indexUrl").empty()?L"尚未绑定远程仓库；当前显示本地插件清单":L"来源："+str(config,L"repository")):catalogMessage,12,true));page.Children().Append(card(body,14));catalogItems=stack(false,10);page.Children().Append(catalogItems);updateCatalogList();page.Children().Append(title(L"已安装插件",19));if(!catalogTried&&!str(config,L"indexUrl").empty()){catalogTried=true;page.DispatcherQueue().TryEnqueue(Microsoft::UI::Dispatching::DispatcherQueuePriority::Low,[this]{if(current==L"plugins"&&!catalogBusy)syncCatalog();});}}
winrt::fire_and_forget syncCatalog(){if(catalogBusy)co_return;auto repository=std::wstring(catalogRepository.Text());repository.erase(std::remove_if(repository.begin(),repository.end(),[](wchar_t c){return iswspace(c)!=0;}),repository.end());if(repository.rfind(L"https://github.com/",0)==0)repository=repository.substr(19);while(!repository.empty()&&repository.back()==L'/')repository.pop_back();auto slash=repository.find(L'/');if(slash==std::wstring::npos||slash==0||slash+1>=repository.size()||repository.find(L'/',slash+1)!=std::wstring::npos||repository.find(L"..")!=std::wstring::npos||!std::all_of(repository.begin(),repository.end(),[](wchar_t c){return (c<128&&iswalnum(c))||c==L'/'||c==L'-'||c==L'_'||c==L'.';})){notice(L"请填写 GitHub 用户名/仓库名",true);co_return;}JsonObject config;put(config,L"repository",repository);put(config,L"indexUrl",L"https://raw.githubusercontent.com/"+repository+L"/main/index.json");write(dataDir()/L"plugin-library"/L"source.json",std::wstring(config.Stringify()));catalogBusy=true;catalogMessage=L"正在同步 GitHub 插件清单…";render();auto lifetime=get_strong();winrt::apartment_context ui;JsonObject result{nullptr};std::wstring error;try{co_await resume_background();result=catalogTask(L"--sync",config);}catch(hresult_error const& e){error=std::wstring(e.message());}co_await ui;catalogBusy=false;if(result&&flag(result,L"ok")){catalogFeed=result;write(dataDir()/L"plugin-library"/L"catalog.json",std::wstring(result.Stringify()));catalogMessage=L"已同步 "+std::to_wstring(result.GetNamedArray(L"plugins").Size())+L" 个插件 · "+repository;}else catalogMessage=L"同步失败，保留已有清单："+(result?str(result,L"error"):error);if(current==L"plugins")render();}
winrt::fire_and_forget downloadCatalogPlugin(JsonObject entry){if(catalogBusy)co_return;catalogBusy=true;catalogMessage=L"正在下载并校验插件…";updateCatalogList();auto lifetime=get_strong();winrt::apartment_context ui;JsonObject result{nullptr};std::wstring error;try{JsonObject input;input.SetNamedValue(L"entry",entry);co_await resume_background();result=catalogTask(L"--download",input);}catch(hresult_error const& e){error=std::wstring(e.message());}co_await ui;catalogBusy=false;if(!result||!flag(result,L"ok")){notice(result?str(result,L"error"):error,true);co_return;}auto manifest=result.GetNamedObject(L"manifest");try{validatePluginUi(manifest);validatePluginModule(manifest);}catch(hresult_error const& e){notice(std::wstring(e.message()),true);co_return;}auto content=stack(false,8);content.Children().Append(text(str(manifest,L"name")+L" · "+str(manifest,L"version")));content.Children().Append(text(L"作者："+str(manifest,L"author")+L"\n来源："+str(entry,L"packageUrl"),12,true));content.Children().Append(text(L"插件包摘要及身份已核对。申请权限：",12));for(auto const& value:manifest.GetNamedArray(L"permissions",JsonArray{}))content.Children().Append(text(std::wstring(value.GetString()),12));ContentDialog dialog;dialog.XamlRoot(page.XamlRoot());dialog.Title(box_value(L"安装插件"));dialog.Content(content);dialog.PrimaryButtonText(L"安装");dialog.CloseButtonText(L"取消");auto answer=co_await dialog.ShowAsync();if(answer!=ContentDialogResult::Primary)co_return;try{for(auto const& value:state.GetNamedArray(L"plugins")){auto p=value.GetObject();if(str(p,L"id")==str(manifest,L"id")&&flag(p,L"installed")){if(str(p,L"author")!=str(manifest,L"author"))throw hresult_invalid_argument(L"更新作者与原插件不匹配");invoke(L"pluginRemove",idBody(str(p,L"id")));break;}}JsonObject input;input.SetNamedValue(L"manifest",manifest);invoke(L"importPlugin",input,true);notice(L"插件已安装");}catch(hresult_error const& e){notice(std::wstring(e.message()),true);}}
