}
std::wstring catalogDeviceLabel(JsonObject p){if(catalogClassification(p).first==L"application")return L"应用插件 · "+catalogCategoryLabel(p);if(!p.HasKey(L"compatibility"))return L"设备与固件信息待补充";auto c=p.GetNamedObject(L"compatibility");std::wstring firmware;for(auto const& v:c.GetNamedArray(L"firmwareVersions",JsonArray{})){if(!firmware.empty())firmware+=L"、";firmware+=std::wstring(v.GetString());}return str(c,L"deviceName")+L" · "+str(c,L"hardwareId")+L" · 固件："+(firmware.empty()?L"待确认":firmware);}
std::wstring catalogTrustLabel(JsonObject p){if(catalogClassification(p).first==L"application")return str(p,L"verificationStatus")==L"verified"?L"应用验证记录已提供":L"未提供应用验证记录";auto c=p.GetNamedObject(L"compatibility",JsonObject{});return (str(p,L"verificationStatus")==L"verified"?std::wstring(L"实机已验证"):std::wstring(L"实机待验证"))+L" · "+(flag(c,L"mobileUi")?(flag(p,L"mobileUiVerified")?L"手机 UI 已验证":L"声明支持手机 UI · 待验收"):L"未声明支持手机 UI");}
bool pluginMatches(JsonObject p){if(pluginQuery.empty())return true;auto hay=str(p,L"name")+L" "+str(p,L"id")+L" "+str(p,L"author")+L" "+str(p,L"description")+L" "+catalogCategoryLabel(p)+L" "+catalogDeviceLabel(p)+L" "+str(p,L"identityCode")+std::wstring(p.GetNamedArray(L"tags",JsonArray{}).Stringify());auto fold=[](std::wstring s){for(auto& c:s)c=(wchar_t)towlower(c);return s;};return fold(hay).find(fold(pluginQuery))!=std::wstring::npos;}
void updateCatalogList(){if(!catalogItems)return;catalogItems.Children().Clear();unsigned count=0;for(auto const& value:catalogFeed.GetNamedArray(L"plugins",JsonArray{})){auto p=value.GetObject();if(!catalogCategoryMatches(p)||!pluginMatches(p))continue;auto row=stack(false,8);auto heading=stack(true,12);heading.Children().Append(title(str(p,L"name"),17));heading.Children().Append(text(L"v"+str(p,L"version"),12,true));row.Children().Append(heading);row.Children().Append(text(catalogCategoryLabel(p),12,true));row.Children().Append(text(catalogDeviceLabel(p),12,true));row.Children().Append(text(str(p,L"description"),13,true));row.Children().Append(text(str(p,L"author"),12,true));row.Children().Append(text(catalogTrustLabel(p),12,true));row.Children().Append(text(str(p,L"identityCode").empty()?L"唯一编码待补充":str(p,L"identityCode"),11,true));bool installed=false;std::wstring installedVersion;for(auto const& v:state.GetNamedArray(L"plugins")){auto current=v.GetObject();if(str(current,L"id")==str(p,L"id")&&flag(current,L"installed")){installed=true;installedVersion=str(current,L"version");}}auto action=button(installed&&installedVersion==str(p,L"version")?L"已安装":installed?L"下载更新":L"下载并安装",[this,p]{downloadCatalogPlugin(p);},!installed);action.IsEnabled(!catalogBusy&&!(installed&&installedVersion==str(p,L"version"))&&!str(catalogFeed,L"indexUrl").empty());catalogItems.Children().Append(card(actionHeader(row,action),14));++count;}if(!count)catalogItems.Children().Append(text(pluginQuery.empty()?L"此分类暂无插件":L"此分类没有匹配的插件",13,true));for(auto const& [tile,p]:installedPluginTiles)tile.Visibility(catalogCategoryMatches(p)&&pluginMatches(p)?Visibility::Visible:Visibility::Collapsed);}
