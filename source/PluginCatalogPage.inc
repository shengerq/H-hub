 groups.Children().Append(button(L"外设插件",[this]{if(pluginGroup==L"peripheral")return;pluginGroup=L"peripheral";pluginCategory=L"all";render();},pluginGroup==L"peripheral"));
 groups.Children().Append(button(L"应用插件",[this]{if(pluginGroup==L"application")return;pluginGroup=L"application";pluginCategory=L"all";render();},pluginGroup==L"application"));
 body.Children().Append(groups);
 std::vector<std::wstring> ids=pluginGroup==L"peripheral"?std::vector<std::wstring>{L"all",L"mouse",L"keyboard",L"headset",L"gamepad",L"other"}:std::vector<std::wstring>{L"all",L"experimental",L"testing",L"other"};
 std::vector<std::wstring> labels=pluginGroup==L"peripheral"?std::vector<std::wstring>{L"全部外设",L"鼠标",L"键盘",L"耳机",L"手柄",L"其他"}:std::vector<std::wstring>{L"全部应用",L"实验型应用",L"测试型应用",L"其他"};
 int selected=0;for(int i=0;i<(int)ids.size();++i)if(ids[i]==pluginCategory)selected=i;
 auto categories=combo(labels,selected,220);Microsoft::UI::Xaml::Automation::AutomationProperties::SetName(categories,L"插件分类");
