std::pair<std::wstring,std::wstring> catalogClassification(JsonObject p){
 if(!p.HasKey(L"group")&&catalogFeed)for(auto const& v:catalogFeed.GetNamedArray(L"plugins",JsonArray{}))if(str(v.GetObject(),L"id")==str(p,L"id")){p=v.GetObject();break;}
 auto group=str(p,L"group"),category=str(p,L"category");if(!group.empty()&&!category.empty())return {group,category};
 auto kind=str(p,L"kind");auto scope=str(p.GetNamedObject(L"compatibility",JsonObject{}),L"scope");
 if(kind==L"mouse"||kind==L"keyboard"||kind==L"headset"||kind==L"audio"||kind==L"gamepad")return {L"peripheral",kind==L"audio"?L"headset":kind};
 if(scope==L"device")return {L"peripheral",L"other"};return {L"application",kind==L"developer-tools"?L"testing":L"other"};
}
std::wstring catalogCategoryLabel(JsonObject p){auto [group,category]=catalogClassification(p);if(group==L"peripheral"){if(category==L"mouse")return L"鼠标";if(category==L"keyboard")return L"键盘";if(category==L"headset")return L"耳机";if(category==L"gamepad")return L"手柄";return L"其他外设";}if(category==L"experimental")return L"实验型应用";if(category==L"testing")return L"测试型应用";return L"其他应用";}
bool catalogCategoryMatches(JsonObject p){auto [group,category]=catalogClassification(p);return group==pluginGroup&&(pluginCategory==L"all"||category==pluginCategory);}
