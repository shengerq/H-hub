 auto lifetime=get_strong();try{
 invoke(L"eqRuntime");auto runtime=eqRuntime();auto apps=runtime.GetNamedArray(L"apps",JsonArray{}),outputs=runtime.GetNamedArray(L"outputs",JsonArray{}),presets=state.GetNamedArray(L"presets");
