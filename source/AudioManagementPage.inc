void audioManagement(){if(!pluginInstalled(state,L"eq")){page.Children().Append(text(tr(L"安装 EQ 插件后可管理应用音频增强。"),14,true));page.Children().Append(button(tr(L"打开插件市场"),[this]{go(L"market");}));return;}
 auto p=stack(false,12);p.Children().Append(title(tr(L"音频管理"),22));
 p.Children().Append(text(tr(L"为后台音乐、语音和游戏分别选择 EQ。切换前台场景不会改变这些绑定。"),14,true));
 auto actions=stack(true,10);actions.Children().Append(button(tr(L"绑定应用与 EQ"),[this]{audioBindingDialog();},true));actions.Children().Append(button(tr(L"添加未运行应用"),[this]{chooseEqApp();}));actions.Children().Append(button(tr(L"刷新播放应用"),[this]{invoke(L"eqRuntime");render();}));p.Children().Append(actions);
 auto runtime=eqRuntime();
 if(!flag(runtime,L"driverReady")||!flag(runtime,L"routingAvailable"))p.Children().Append(text(tr(L"当前音频链路未就绪：可保存绑定，设备与路由可用后自动处理。"),13,true));
 p.Children().Append(text(tr(L"耳机自身 EQ 会影响全部声音；逐应用 EQ 请使用通用 EQ，并将耳机自身 EQ 设为平直或关闭。当前插件未提供可由宿主切换的耳机 EQ 接口。"),12,true));
 auto apps=runtime.GetNamedArray(L"apps",JsonArray{}),outputs=runtime.GetNamedArray(L"outputs",JsonArray{});auto label=[](JsonArray list,std::wstring id){for(auto const& v:list)if(str(v.GetObject(),L"id")==id)return str(v.GetObject(),L"name");return id;};
 auto prefs=state.GetNamedArray(L"eqRealPrefs",JsonArray{});if(!prefs.Size())p.Children().Append(text(tr(L"尚未绑定。添加音乐播放器后，即使游戏在前台，它也会保持自己的 EQ。"),14));
 for(auto const& v:prefs){auto c=v.GetObject();auto app=str(c,L"app"),output=str(c,L"output");auto row=stack(false,8);row.Children().Append(title(label(apps,app),17));row.Children().Append(text(label(outputs,output),13,true));
 std::wstring preset=tr(L"自定义");for(auto const& item:state.GetNamedArray(L"presets"))if(str(item.GetObject(),L"id")==str(c,L"preset"))preset=str(item.GetObject(),L"name");row.Children().Append(text(tr(L"通用 EQ · ")+preset,14));
 std::wstring status=flag(c,L"backgroundAutoStart")?tr(L"后台播放自动处理 · 等待链路或应用发声"):tr(L"已保存 · 自动处理关闭");
 for(auto const& stream:runtime.GetNamedArray(L"streams",JsonArray{})){auto t=stream.GetObject();if(str(t,L"app")==app&&str(t,L"output")==output){status=str(t,L"state");if(!str(t,L"error").empty())status+=L" · "+str(t,L"error");}}
 auto statusText=text(status,12,true);row.Children().Append(statusText);applicationBindings.push_back([statusText,app,output](JsonObject next){bool armed=false;for(auto const& v:next.GetNamedArray(L"eqRealPrefs",JsonArray{})){auto c=v.GetObject();if(str(c,L"app")==app&&str(c,L"output")==output)armed=flag(c,L"backgroundAutoStart");}std::wstring value=armed?tr(L"后台播放自动处理 · 等待链路或应用发声"):tr(L"已保存 · 自动处理关闭");for(auto const& v:next.GetNamedObject(L"eqRuntime",JsonObject{}).GetNamedArray(L"streams",JsonArray{})){auto t=v.GetObject();if(str(t,L"app")==app&&str(t,L"output")==output){value=str(t,L"state");if(!str(t,L"error").empty())value+=L" · "+str(t,L"error");}}statusText.Text(value);});auto tools=stack(true,8);tools.Children().Append(button(tr(L"修改绑定"),[this,c]{audioBindingDialog(c);}));tools.Children().Append(button(tr(L"调节 EQ"),[this,app,output]{stashEqDraft();eqApp=app;eqOutput=output;go(L"eq",true);}));tools.Children().Append(button(tr(L"停止并恢复原声"),[this,app,output]{JsonObject b;put(b,L"app",app);put(b,L"output",output);invoke(L"audioBindingDisable",b);render();}));tools.Children().Append(button(tr(L"解除绑定"),[this,app,output]{JsonObject b;put(b,L"app",app);put(b,L"output",output);invoke(L"audioBindingRemove",b);render();}));onSizeChanged(tools,[tools](auto const&,SizeChangedEventArgs const& e){tools.Orientation(e.NewSize().Width<520?Orientation::Vertical:Orientation::Horizontal);});row.Children().Append(tools);p.Children().Append(card(row,16));
 }
 page.Children().Append(p);
}
