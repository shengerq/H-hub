 ContentDialog dialog;dialog.XamlRoot(page.XamlRoot());dialog.Title(box_value(tr(L"绑定后台应用 EQ")));dialog.Content(content);dialog.PrimaryButtonText(tr(L"保存绑定"));dialog.CloseButtonText(tr(L"取消"));if(co_await showDialog(dialog)!=ContentDialogResult::Primary)co_return;
 auto chosen=presets.GetObjectAt(preset.SelectedIndex());bool same=str(saved,L"preset")==str(chosen,L"id")&&saved.HasKey(L"bands");auto config=object(std::wstring((same?saved:chosen).Stringify()));put(config,L"app",str(apps.GetObjectAt(app.SelectedIndex()),L"id"));put(config,L"output",str(outputs.GetObjectAt(output.SelectedIndex()),L"id"));put(config,L"preset",str(chosen,L"id"));put(config,L"enabled",true);put(config,L"autoPreamp",true);if(!same)put(config,L"preamp",0.0);auto sources=runtime.GetNamedArray(L"sources",JsonArray{});put(config,L"source",sources.Size()?str(sources.GetObjectAt(0),L"id"):std::wstring());put(config,L"backgroundAutoStart",automatic.IsOn());
 invoke(L"eqRealSave",config);if(!automatic.IsOn()){JsonObject stop;put(stop,L"app",str(config,L"app"));put(stop,L"output",str(config,L"output"));invoke(L"audioBindingDisable",stop);}invoke(L"eqRuntime");render();notice(tr(L"绑定已保存，实际处理状态见音频管理。"));
 }catch(hresult_error const& e){notice(std::wstring(e.message()),true);}
