 for(int i=0;i<150&&!pluginInstalled(state,L"eq");i++){co_await winrt::resume_after(std::chrono::milliseconds(200));co_await ui;}if(!pluginInstalled(state,L"eq"))throw hresult_error(E_FAIL,L"Install timed out");
