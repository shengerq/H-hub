double reproPrivateWorkingMB(){PROCESS_MEMORY_COUNTERS c{};GetProcessMemoryInfo(GetCurrentProcess(),&c,sizeof(c));std::vector<unsigned char> memory(sizeof(PSAPI_WORKING_SET_INFORMATION)+(c.WorkingSetSize/4096+4096)*sizeof(PSAPI_WORKING_SET_BLOCK));if(!QueryWorkingSet(GetCurrentProcess(),memory.data(),(DWORD)memory.size()))return -1;auto data=(PSAPI_WORKING_SET_INFORMATION*)memory.data();size_t pages=0;for(ULONG_PTR i=0;i<data->NumberOfEntries;i++)if(!data->WorkingSetInfo[i].Shared)++pages;SYSTEM_INFO info{};GetSystemInfo(&info);return pages*info.dwPageSize/1048576.0;}
// Visible isolated UI reproduction: real catalog download/dialog and native EQ page,
// with a cloned model. Never connects to the user's Core or changes audio settings.
winrt::fire_and_forget closeReproDialog(ContentDialog dialog){winrt::apartment_context ui;co_await winrt::resume_after(std::chrono::milliseconds(1200));co_await ui;dialog.Hide();}
