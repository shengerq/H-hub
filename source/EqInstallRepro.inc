void sampleEqInstallRepro(std::string phase){PROCESS_MEMORY_COUNTERS_EX c{};GetProcessMemoryInfo(GetCurrentProcess(),(PROCESS_MEMORY_COUNTERS*)&c,sizeof(c));size_t alive=0,canvases=0;for(auto const& weak:retiredPages)if(weak.get())++alive;for(auto const& weak:reproEqHosts)if(weak.get())++canvases;std::ofstream out(dataDir()/L"eq-install-repro.csv",std::ios::app);out<<phase<<","<<c.PrivateUsage/1048576.0<<","<<c.WorkingSetSize/1048576.0<<","<<alive<<","<<canvases<<","<<pageEventCleanup.size()+catalogEventCleanup.size()<<","<<reproPrivateWorkingMB()<<","<<GetGuiResources(GetCurrentProcess(),GR_GDIOBJECTS)<<","<<GetGuiResources(GetCurrentProcess(),GR_USEROBJECTS)<<","<<(nativeEq?nativeEq->windowCount():0)<<","<<to_string(current)<<","<<openDialogs.size()<<","<<(nativeEq?nativeEq->client().right:0)<<","<<(nativeEq?nativeEq->client().bottom:0)<<","<<(nativeEq&&IsWindowVisible(nativeEq->window)?1:0)<<"\n";}
