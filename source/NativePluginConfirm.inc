bool confirmCatalogInstall(JsonObject manifest,JsonObject entry){std::wstring heading=str(manifest,L"name")+L" · "+str(manifest,L"version");std::wstring message=tr(L"作者：")+str(manifest,L"author")+tr(L"\n来源：")+str(entry,L"packageUrl")+tr(L"\n\n插件包摘要及身份已核对。申请权限：");for(auto const& v:manifest.GetNamedArray(L"permissions",JsonArray{}))message+=L"\n• "+std::wstring(v.GetString());if(str(manifest,L"id")==L"eq"&&manifest.HasKey(L"nativeAssets"))message+=tr(L"\n\n包含 FxSound 官方签名虚拟音频驱动的安装程序。安装驱动需另行确认管理员授权，可能需要重启；取消不影响曲线编辑。");TASKDIALOG_BUTTON buttons[]={{IDYES,tr(L"安装")},{IDCANCEL,tr(L"取消")}};TASKDIALOGCONFIG config{sizeof(config)};config.hwndParent=hwnd;config.dwFlags=TDF_ALLOW_DIALOG_CANCELLATION|TDF_POSITION_RELATIVE_TO_WINDOW|TDF_SIZE_TO_CONTENT;config.pszWindowTitle=tr(L"安装插件");config.pszMainInstruction=heading.c_str();config.pszContent=message.c_str();config.cButtons=2;config.pButtons=buttons;config.nDefaultButton=IDCANCEL;config.pfCallback=[](HWND dialog,UINT event,WPARAM,LPARAM,LONG_PTR)->HRESULT{if(event==TDN_CREATED&&eqInstallReproEnabled())SetTimer(dialog,1,1200,[](HWND dialog,UINT,UINT_PTR id,DWORD){KillTimer(dialog,id);SendMessageW(dialog,TDM_CLICK_BUTTON,IDYES,0);});return S_OK;};int choice=IDCANCEL;check_hresult(TaskDialogIndirect(&config,&choice,nullptr,nullptr));return choice==IDYES;}
