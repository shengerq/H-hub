// Process isolation shared by every native plugin, including its page and services.
inline bool nativeModuleLocal=false;
inline std::map<std::wstring,std::wstring>& pluginFailures(){static std::map<std::wstring,std::wstring> values;return values;}
inline std::wstring pluginJobName(std::wstring const& id){auto text=to_string(dataDir().wstring());std::vector<unsigned char> bytes(text.begin(),text.end());return L"Local\\Hhub.Plugin."+nativeAssetDigest(bytes).substr(0,20)+L"."+id;}
struct PluginJobs{std::map<std::wstring,HANDLE> handles;~PluginJobs(){for(auto const& item:handles)CloseHandle(item.second);}};
inline HANDLE pluginJob(std::wstring const& id){if(!validPluginId(id))throw hresult_invalid_argument();static PluginJobs jobs;auto it=jobs.handles.find(id);if(it!=jobs.handles.end())return it->second;auto job=CreateJobObjectW(nullptr,pluginJobName(id).c_str());check_bool(job!=nullptr);JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};limits.BasicLimitInformation.LimitFlags=JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;check_bool(SetInformationJobObject(job,JobObjectExtendedLimitInformation,&limits,sizeof(limits)));jobs.handles[id]=job;return job;}
inline void forceStopPlugin(std::wstring const& id){check_bool(TerminateJobObject(pluginJob(id),ERROR_PROCESS_ABORTED));}
inline DWORD pluginProcessCount(std::wstring const& id){JOBOBJECT_BASIC_ACCOUNTING_INFORMATION info{};if(!QueryInformationJobObject(pluginJob(id),JobObjectBasicAccountingInformation,&info,sizeof(info),nullptr))return 0;return info.ActiveProcesses;}
inline bool pluginPipeTransfer(HANDLE pipe,void* data,DWORD size,bool writing,DWORD timeout=5000){DWORD done=0;auto deadline=GetTickCount64()+timeout;while(done<size){auto event=CreateEventW(nullptr,TRUE,FALSE,nullptr);OVERLAPPED ov{};ov.hEvent=event;DWORD n{};BOOL ok=writing?WriteFile(pipe,(char*)data+done,size-done,&n,&ov):ReadFile(pipe,(char*)data+done,size-done,&n,&ov);if(!ok&&GetLastError()==ERROR_IO_PENDING){auto now=GetTickCount64();if(WaitForSingleObject(event,now>=deadline?0:(DWORD)(deadline-now))==WAIT_OBJECT_0)ok=GetOverlappedResult(pipe,&ov,&n,FALSE);else{CancelIoEx(pipe,&ov);WaitForSingleObject(event,INFINITE);}}CloseHandle(event);if(!ok||!n)return false;done+=n;}return true;}
inline bool pluginPipeWrite(HANDLE pipe,JsonObject value){auto text=to_string(value.Stringify());DWORD size=(DWORD)text.size();return size<=32*1024*1024&&pluginPipeTransfer(pipe,&size,4,true)&&pluginPipeTransfer(pipe,text.data(),size,true);}
inline bool pluginPipeRead(HANDLE pipe,JsonObject& value,DWORD timeout=5000){DWORD size{};if(!pluginPipeTransfer(pipe,&size,4,false,timeout)||!size||size>32*1024*1024)return false;std::string text(size,'\0');if(!pluginPipeTransfer(pipe,text.data(),size,false,timeout))return false;value=object(std::wstring(to_hstring(text)));return true;}
struct PluginProcess{
 HANDLE process{},pipe=INVALID_HANDLE_VALUE;DWORD pid{};std::wstring owner;std::recursive_mutex mutex;
 PluginProcess()=default;PluginProcess(PluginProcess const&)=delete;PluginProcess& operator=(PluginProcess const&)=delete;
 ~PluginProcess(){close();}
 bool alive()const{return process&&WaitForSingleObject(process,0)==WAIT_TIMEOUT;}
 void close(){std::scoped_lock lock(mutex);if(pipe!=INVALID_HANDLE_VALUE){if(alive()){try{JsonObject request;put(request,L"kind",std::wstring(L"shutdown"));pluginPipeWrite(pipe,request);}catch(...) {}}CloseHandle(pipe);pipe=INVALID_HANDLE_VALUE;}if(process){if(WaitForSingleObject(process,1500)==WAIT_TIMEOUT)TerminateProcess(process,ERROR_PROCESS_ABORTED);WaitForSingleObject(process,3000);CloseHandle(process);process=nullptr;}pid=0;}
 JsonObject call(JsonObject request){std::scoped_lock lock(mutex);JsonObject reply;if(!alive()||!pluginPipeWrite(pipe,request)||!pluginPipeRead(pipe,reply)){pluginFailures()[owner]=L"插件无响应或异常退出";close();throw hresult_error(HRESULT_FROM_WIN32(ERROR_TIMEOUT),L"插件无响应或已退出，可从插件管理重新打开");}if(!flag(reply,L"ok"))throw hresult_error(E_FAIL,str(reply,L"error").c_str());return reply;}
 void start(std::wstring const& id,std::wstring const& mode,JsonObject initial={},HWND parent=nullptr){
  std::scoped_lock lock(mutex);close();owner=id;verifyNativeAssets(id);auto manifest=nativeManifest(id);auto pipeName=L"\\\\.\\pipe\\Hhub.Plugin."+std::to_wstring(GetCurrentProcessId())+L"."+std::to_wstring(GetTickCount64())+L"."+id;
  pipe=CreateNamedPipeW(pipeName.c_str(),PIPE_ACCESS_DUPLEX|FILE_FLAG_OVERLAPPED|FILE_FLAG_FIRST_PIPE_INSTANCE,PIPE_TYPE_BYTE|PIPE_READMODE_BYTE|PIPE_WAIT|PIPE_REJECT_REMOTE_CLIENTS,1,65536,65536,0,nullptr);check_bool(pipe!=INVALID_HANDLE_VALUE);
  wchar_t current[32768]{};GetModuleFileNameW(nullptr,current,32768);auto folder=std::filesystem::path(current).parent_path();auto exe=folder/L"Hhub.PluginHost.exe";if(!std::filesystem::exists(exe))exe=folder/L"runtime/Hhub.PluginHost.exe";
  auto command=L"\""+exe.wstring()+L"\" --plugin-host "+id+L" "+mode+L" \""+pipeName+L"\"";STARTUPINFOW si{sizeof(si)};si.dwFlags=STARTF_USESHOWWINDOW;si.wShowWindow=SW_HIDE;PROCESS_INFORMATION pi{};
  if(!CreateProcessW(exe.c_str(),command.data(),nullptr,nullptr,FALSE,CREATE_SUSPENDED|CREATE_NO_WINDOW,nullptr,exe.parent_path().c_str(),&si,&pi)){close();throw hresult_error(HRESULT_FROM_WIN32(GetLastError()),L"无法启动插件进程");}process=pi.hProcess;pid=pi.dwProcessId;
  if(!AssignProcessToJobObject(pluginJob(id),process)){TerminateProcess(process,ERROR_PROCESS_ABORTED);CloseHandle(pi.hThread);close();throw hresult_error(E_FAIL,L"无法隔离插件进程");}ResumeThread(pi.hThread);CloseHandle(pi.hThread);
  auto event=CreateEventW(nullptr,TRUE,FALSE,nullptr);OVERLAPPED ov{};ov.hEvent=event;BOOL connected=ConnectNamedPipe(pipe,&ov);auto error=GetLastError();if(!connected&&error==ERROR_IO_PENDING){HANDLE wait[]{event,process};if(WaitForMultipleObjects(2,wait,FALSE,15000)==WAIT_OBJECT_0){DWORD bytes{};connected=GetOverlappedResult(pipe,&ov,&bytes,FALSE);}else{CancelIoEx(pipe,&ov);WaitForSingleObject(event,INFINITE);}}else if(error==ERROR_PIPE_CONNECTED)connected=TRUE;CloseHandle(event);if(!connected){close();throw hresult_error(E_FAIL,L"插件进程启动失败");}
  JsonObject request;put(request,L"kind",std::wstring(L"initialize"));put(request,L"parent",(double)(uintptr_t)parent);request.SetNamedValue(L"manifest",manifest);request.SetNamedValue(L"initial",initial);call(request);pluginFailures().erase(owner);
 }
};
