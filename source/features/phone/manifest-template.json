{
  "schemaVersion": 1,
  "id": "phone",
  "name": "Hhub 手机遥控",
  "author": "H hub",
  "version": "1.0",
  "apiVersion": "1.0",
  "kind": "application",
  "description": "手机遥控插件：自带配对页面、统一二维码、设备授权管理、连接帮助、后台服务与手机网页。",
  "requiredHost": {
    "id": "hhub",
    "apiVersion": "1.4",
    "execution": "host-only",
    "standalone": false,
    "minimumVersion": "1.0",
    "releaseEpoch": 1
  },
  "permissions": [
    "本机局域网服务",
    "手机配对授权"
  ],
  "updateUrl": "",
  "compatibility": {
    "version": 1,
    "scope": "tool",
    "deviceName": "",
    "hardwareId": "",
    "firmwareVersions": [],
    "mobileUi": false
  },
  "implementation": {
    "type": "native-module",
    "abiVersion": 1,
    "library": "Hhub.Phone.UI.dll"
  },
  "nativeAssets": [],
  "navigation": {
    "title": "手机遥控",
    "glyph": ""
  },
  "capabilities": [
    "state",
    "start",
    "stop",
    "rotate",
    "approve",
    "reject",
    "revoke",
    "permission",
    "remoteStatus",
    "remoteAction",
    "authorize",
    "jobValidate",
    "jobAck",
    "resume",
    "uninstall",
    "status"
  ],
  "hostOperations": [
    "applyScene",
    "unlockScene",
    "deviceProfileSelect",
    "deviceProfileRetry",
    "pluginTaskSubmit",
    "eqRealSave",
    "eqStart",
    "eqStop",
    "audioBindingDisable"
  ],
  "lifecycle": {
    "startup": "resume",
    "uninstall": "uninstall",
    "shutdown": "shutdown",
    "uninstallMessage": "将停止手机连接服务并清除配对、授权、证书和连接设置，重新安装后需要重新配对。"
  },
  "workerExtensions": [
    "phone-worker.js"
  ],
  "releaseEpoch": 1,
  "routeAliases": [
    {
      "route": "phone"
    }
  ]
}
