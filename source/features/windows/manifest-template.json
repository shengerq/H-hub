{
  "schemaVersion": 1,
  "id": "windows",
  "name": "Hhub Windows 设置",
  "author": "H hub",
  "version": "1.0",
  "apiVersion": "1.0",
  "kind": "application",
  "description": "独立 Windows 设置页面、预设和系统设置管理。",
  "nativePage": "windows",
  "requiredHost": {
    "id": "hhub",
    "apiVersion": "1.4",
    "execution": "host-only",
    "standalone": false,
    "minimumVersion": "1.0",
    "releaseEpoch": 1
  },
  "permissions": [
    "Windows 系统设置读取",
    "Windows 游戏与输入设置修改",
    "部分系统设置需要管理员授权"
  ],
  "updateUrl": "",
  "compatibility": {
    "version": 1,
    "scope": "tool",
    "deviceName": "",
    "hardwareId": "",
    "firmwareVersions": [],
    "mobileUi": false
  },
  "implementation": {
    "type": "native-module",
    "abiVersion": 1,
    "library": "Hhub.Windows.UI.dll",
    "notes": "插件自行提供 UI、预设和业务功能；由宿主独立进程承载并嵌入内容区域。"
  },
  "nativeAssets": [],
  "bundledSettings": [
    {
      "id": "gameMode",
      "name": "游戏模式",
      "uri": "ms-settings:gaming-gamemode"
    },
    {
      "id": "controllerGameBar",
      "name": "手柄打开 Game Bar",
      "uri": "ms-settings:gaming-gamebar"
    },
    {
      "id": "capture",
      "name": "游戏录制与捕获",
      "uri": "ms-settings:gaming-gamedvr"
    },
    {
      "id": "gpuScheduling",
      "name": "硬件加速 GPU 调度",
      "uri": "ms-settings:display-advancedgraphics-default"
    },
    {
      "id": "windowedOptimizations",
      "name": "窗口化游戏优化",
      "uri": "ms-settings:display-advancedgraphics-default"
    },
    {
      "id": "hdr",
      "name": "HDR",
      "uri": "ms-settings:display"
    },
    {
      "id": "mousePrecision",
      "name": "提高指针精确度",
      "uri": "ms-settings:mousetouchpad"
    },
    {
      "id": "stickyShortcut",
      "name": "五次 Shift 启用粘滞键",
      "uri": "ms-settings:easeofaccess-keyboard"
    },
    {
      "id": "filterShortcut",
      "name": "长按右 Shift 启用筛选键",
      "uri": "ms-settings:easeofaccess-keyboard"
    },
    {
      "id": "toggleShortcut",
      "name": "长按 Num Lock 启用切换键",
      "uri": "ms-settings:easeofaccess-keyboard"
    },
    {
      "id": "notifications",
      "name": "系统通知",
      "uri": "ms-settings:notifications"
    },
    {
      "id": "systemSound",
      "name": "系统声音",
      "uri": "ms-settings:apps-volume"
    }
  ],
  "navigation": {
    "title": "Windows 设置",
    "glyph": "",
    "iconGrid": 2,
    "localizedTitles": {
      "zh-CN": "Windows 设置",
      "en-US": "Windows settings"
    }
  },
  "capabilities": [
    "catalog",
    "worker",
    "host"
  ],
  "lifecycle": {
    "uninstall": "cleanup"
  },
  "releaseEpoch": 1,
  "hostIntegration": {
    "entry": "host",
    "operations": [
      "windowsSnapshot",
      "windowsSet",
      "windowsRestore",
      "windowsPower"
    ],
    "stateKeys": [
      "windowsSettings",
      "windowsCleanupError"
    ],
    "ownedStateKeys": [
      "windowsSettings",
      "windowsCleanupError"
    ],
    "transientStateKeys": [
      "windowsSettings"
    ]
  },
  "routeAliases": [
    {
      "route": "windows"
    }
  ],
  "uninstallNotice": "将停止插件后台、移除页面和插件配置。已应用到系统的设置保持不变。",
  "storage": {
    "migrationFiles": [
      {
        "path": "windows-settings-undo.json",
        "format": "json",
        "maxBytes": 1048576
      }
    ]
  }
}
