#pragma code_page(65001)
#include <windows.h>

#include <ntverp.h>

#define VER_FILETYPE                VFT_DRV
#define VER_FILESUBTYPE             VFT2_DRV_SOUND
#define VER_FILEDESCRIPTION_STR     "Hhub Audio"

#define VER_INTERNALNAME_STR        "hhubvad.sys"
#define VER_ORIGINALFILENAME_STR    "hhubvad.sys"

#define VER_LEGALCOPYRIGHT_YEARS    "2021"
#define VER_LEGALCOPYRIGHT_STR	    "Copyright (C) FxSound LLC; Hhub modifications (C) 2026"

#define VER_FILEVERSION             1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0"

#undef VER_PRODUCTVERSION
#define VER_PRODUCTVERSION          VER_FILEVERSION

#undef VER_PRODUCTVERSION_STR
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR

#undef VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR         "Hhub"

101 ICON "hhub.ico"

// Modification notice and original licenses travel with the binary as resources.
201 RCDATA "..\\DRIVER-NOTICE.txt"
202 RCDATA "..\\LICENSE"
203 RCDATA "..\\license.rtf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VER_FILETYPE
FILESUBTYPE VER_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Hhub"
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", VER_INTERNALNAME_STR
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "ProductName", VER_PRODUCTNAME_STR
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
            VALUE "LegalCopyright", "Copyright (c) Microsoft Corporation; FxSound LLC; Hhub modifications (c) 2026"
            VALUE "Comments", "FxSound 开源驱动修改版，底层音频传输沿用 FxSound 实现；命名及标识修改用于避免与原驱动冲突，保留原版权与适用许可。 Based on FxSound open-source driver. Independent Hhub identities prevent conflicts with the original driver. See DRIVER-NOTICE.txt, LICENSE and license.rtf."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END



