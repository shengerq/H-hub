void positionNativeEq(){if(!nativeEq||!nativeEqHost||!shell||!nativeEqHost.IsLoaded())return;if(hasOpenDialog()){ShowWindow(nativeEq->window,SW_HIDE);return;}double width=pageScroll.ActualWidth(),height=pageScroll.ActualHeight();if(width<=0||height<=0)return;if(std::abs(nativeEqHost.Height()-height)>.5)nativeEqHost.Height(height);auto at=pageScroll.TransformToVisual(shell).TransformPoint({0,0});double dpi=GetDpiForWindow(hwnd)/96.0;RECT rect{(LONG)std::lround(at.X*dpi),(LONG)std::lround(at.Y*dpi),(LONG)std::lround(width*dpi),(LONG)std::lround(height*dpi)};if(rect.right<1||rect.bottom<1)return;bool resized=!EqualRect(&rect,&nativeEqRect);if(resized){nativeEqRect=rect;SetWindowPos(nativeEq->window,HWND_TOP,rect.left,rect.top,rect.right,rect.bottom,SWP_NOACTIVATE|SWP_SHOWWINDOW);}else if(!IsWindowVisible(nativeEq->window))ShowWindow(nativeEq->window,SW_SHOWNOACTIVATE);RECT toast{};if(feedback.IsOpen()&&feedback.root.IsLoaded()){auto point=feedback.root.TransformToVisual(shell).TransformPoint({0,0});RECT frame{rect.left,rect.top,rect.left+rect.right,rect.top+rect.bottom},notice{(LONG)(point.X*dpi),(LONG)(point.Y*dpi),(LONG)((point.X+feedback.root.ActualWidth())*dpi),(LONG)((point.Y+feedback.root.ActualHeight())*dpi)};if(IntersectRect(&toast,&frame,&notice))OffsetRect(&toast,-rect.left,-rect.top);}
 int pane=nav.IsPaneOpen()&&nav.DisplayMode()!=NavigationViewDisplayMode::Expanded?std::max<int>(0,(int)std::lround(nav.OpenPaneLength()*dpi)-rect.left):0;if(resized||!EqualRect(&toast,&nativeToastClip)||pane!=nativePaneClip){nativeToastClip=toast;nativePaneClip=pane;if(IsRectEmpty(&toast)&&!pane)SetWindowRgn(nativeEq->window,nullptr,TRUE);else{auto region=CreateRectRgn(0,0,rect.right,rect.bottom);if(!IsRectEmpty(&toast)){auto cut=CreateRectRgnIndirect(&toast);CombineRgn(region,region,cut,RGN_DIFF);DeleteObject(cut);}if(pane){auto cut=CreateRectRgn(0,0,pane,rect.bottom);CombineRgn(region,region,cut,RGN_DIFF);DeleteObject(cut);}if(!SetWindowRgn(nativeEq->window,region,TRUE))DeleteObject(region);}}if(nativeEq->xaml){JsonObject request;put(request,L"action",std::wstring(L"layout"));put(request,L"pane",(double)pane);put(request,L"toastLeft",(double)toast.left);put(request,L"toastTop",(double)toast.top);put(request,L"toastRight",(double)toast.right);put(request,L"toastBottom",(double)toast.bottom);nativeEq->command(request);}}


