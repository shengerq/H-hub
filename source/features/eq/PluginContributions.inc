Grid actionHeader(UIElement left,UIElement right){Grid g;g.ColumnSpacing(12);ColumnDefinition a;a.Width({1,GridUnitType::Star});ColumnDefinition b;b.Width({0,GridUnitType::Auto});g.ColumnDefinitions().Append(a);g.ColumnDefinitions().Append(b);g.Children().Append(left);Grid::SetColumn(right.as<FrameworkElement>(),1);g.Children().Append(right);return g;}
ComboBox combo(std::vector<std::wstring> values,int selected=0,double width=280){ComboBox c;c.Width(width);for(auto const& value:values)c.Items().Append(box_value(value));if(selected>=0&&selected<(int)values.size())c.SelectedIndex(selected);return c;}
