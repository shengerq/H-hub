inline void Page::renderSettings(){auto config=object(std::wstring(draft.Stringify()));auto body=stack(false,18);body.MaxWidth(680);body.HorizontalAlignment(HorizontalAlignment::Left);NumberBox count;count.Header(box_value(tr(L"频段数量 · 1–12")));count.Minimum(1);count.Maximum(12);count.SmallChange(1);count.LargeChange(1);count.SpinButtonPlacementMode(NumberBoxSpinButtonPlacementMode::Inline);count.Value((double)eqActiveBands(config).size());Automation::AutomationProperties::SetAutomationId(count,L"eq-band-count");body.Children().Append(count);ToggleSwitch protect;protect.Header(box_value(tr(L"自动增益保护")));protect.IsOn(flag(config,L"autoPreamp",true));body.Children().Append(protect);Slider preamp;preamp.Header(box_value(tr(L"前级增益 · dB")));preamp.Minimum(-24);preamp.Maximum(0);preamp.StepFrequency(.5);preamp.Value(num(config,L"preamp"));body.Children().Append(preamp);
auto values=[config,count,protect,preamp]()mutable{if(!std::isfinite(count.Value())||count.Value()<1||count.Value()>12||std::floor(count.Value())!=count.Value())throw hresult_invalid_argument(tr(L"请输入 1–12 的整数"));int n=(int)count.Value();if(n!=(int)eqActiveBands(config).size()){JsonArray bands;if(n==10){for(int i=1;i<=10;i++)bands.Append(JsonValue::CreateNumberValue(i));}else for(int i=0;i<n;i++)bands.Append(JsonValue::CreateNumberValue(n==1?5:(int)std::round(i*11.0/(n-1))));config.SetNamedValue(L"activeBands",bands);}put(config,L"autoPreamp",protect.IsOn());put(config,L"preamp",preamp.Value());return object(std::wstring(config.Stringify()));};auto actions=stack(true,12);actions.Children().Append(button(tr(L"保存并返回"),[this,values]()mutable{this->config=values();saveConfig();refreshEditor();settingsVisible=false;render();},true));actions.Children().Append(button(tr(L"返回"),[this]{settingsVisible=false;render();}));body.Children().Append(actions);body.Children().Append(button(tr(L"恢复 FxSound 默认频率"),[this,values]()mutable{this->config=values();JsonArray frequencies,bands;for(double f:EqDsp::frequencies)frequencies.Append(JsonValue::CreateNumberValue(f));for(int i=1;i<=10;i++)bands.Append(JsonValue::CreateNumberValue(i));this->config.SetNamedValue(L"frequencies",frequencies);this->config.SetNamedValue(L"activeBands",bands);saveConfig();refreshEditor();draft=object(std::wstring(this->config.Stringify()));render();}));body.Children().Append(button(tr(L"保存为预设"),[this,values]()mutable{savePreset(values());}));body.Children().Append(button(tr(L"独立安装虚拟音频驱动"),[this]{installDriver();}));body.Children().Append(button(tr(L"音频驱动与连接"),[this]{connectionDialog();}));ScrollViewer scroll;scroll.HorizontalScrollBarVisibility(ScrollBarVisibility::Disabled);scroll.HorizontalScrollMode(ScrollMode::Disabled);scroll.Content(card(body,22));Grid::SetRow(scroll,1);root.Children().Append(scroll);}
