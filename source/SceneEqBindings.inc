void sceneEqBindings(){
 auto panel=stack(false,14);panel.Children().Append(title(L"EQ 绑定",20));auto runtime=eqRuntime();auto apps=runtime.GetNamedArray(L"apps",JsonArray{}),outputs=runtime.GetNamedArray(L"outputs",JsonArray{});auto label=[](JsonArray values,std::wstring id){for(auto const& v:values)if(str(v.GetObject(),L"id")==id)return str(v.GetObject(),L"name");return id;};
 for(auto const& value:state.GetNamedArray(L"eqRealPrefs",JsonArray{})){auto config=value.GetObject();auto app=str(config,L"app"),output=str(config,L"output");std::wstring preset=L"自定义";for(auto const& p:state.GetNamedArray(L"presets"))if(str(p.GetObject(),L"id")==str(config,L"preset"))preset=str(p.GetObject(),L"name");Grid row;row.ColumnSpacing(0);for(int i=0;i<2;i++){ColumnDefinition col;col.Width({1,GridUnitType::Star});row.ColumnDefinitions().Append(col);}
 auto appContent=stack(false,4);appContent.Children().Append(text(L"应用："+label(apps,app),16));appContent.Children().Append(text(label(outputs,output),12,true));auto appButton=button(L"",[this,config]{audioBindingDialog(config);});appButton.Content(appContent);appButton.HorizontalAlignment(HorizontalAlignment::Stretch);appButton.MinHeight(66);appButton.CornerRadius(CornerRadius{10,10,10,10});row.Children().Append(appButton);
 auto eqContent=stack(false,4);auto presetText=text(L"EQ："+preset,16);presetText.HorizontalAlignment(HorizontalAlignment::Center);eqContent.Children().Append(presetText);auto status=text(flag(config,L"backgroundAutoStart")?L"后台播放自动使用":L"已保存 · 自动处理关闭",12,true);status.HorizontalAlignment(HorizontalAlignment::Center);eqContent.Children().Append(status);auto eqButton=button(L"",[this,config]{audioBindingDialog(config);});eqButton.Content(eqContent);eqButton.HorizontalAlignment(HorizontalAlignment::Stretch);eqButton.MinHeight(66);eqButton.CornerRadius(CornerRadius{10,10,10,10});Grid::SetColumn(eqButton,1);row.Children().Append(eqButton);
 MenuFlyout menu;auto item=[&](std::wstring name,std::function<void()> fn){MenuFlyoutItem entry;entry.Text(name);entry.Click([fn](auto const&,auto const&){fn();});menu.Items().Append(entry);};item(L"调节 EQ",[this,app,output]{stashEqDraft();eqApp=app;eqOutput=output;go(L"eq");});item(L"停止并恢复原声",[this,app,output]{JsonObject b;put(b,L"app",app);put(b,L"output",output);invoke(L"audioBindingDisable",b,true);});item(L"移除 EQ 绑定",[this,app,output]{JsonObject b;put(b,L"app",app);put(b,L"output",output);invoke(L"audioBindingRemove",b,true);});row.ContextFlyout(menu);panel.Children().Append(row);
 applicationBindings.push_back([status,app,output](JsonObject next){bool automatic=false;for(auto const& v:next.GetNamedArray(L"eqRealPrefs",JsonArray{})){auto c=v.GetObject();if(str(c,L"app")==app&&str(c,L"output")==output)automatic=flag(c,L"backgroundAutoStart");}std::wstring value=automatic?L"后台播放自动使用 · 等待音频链路":L"已保存 · 自动处理关闭";for(auto const& v:next.GetNamedObject(L"eqRuntime",JsonObject{}).GetNamedArray(L"streams",JsonArray{})){auto c=v.GetObject();if(str(c,L"app")==app&&str(c,L"output")==output)value=str(c,L"state")+(str(c,L"error").empty()?L"":L" · "+str(c,L"error"));}status.Text(value);});
 }
 auto add=button(L"＋",[this]{audioBindingDialog();});add.FontSize(28);add.Height(58);add.HorizontalAlignment(HorizontalAlignment::Stretch);add.CornerRadius(CornerRadius{10,10,10,10});panel.Children().Append(add);panel.Children().Append(text(L"后台应用的 EQ 独立保存，不随前台场景切换。",12,true));auto frame=card(panel,22);frame.CornerRadius(CornerRadius{22,22,22,22});page.Children().Append(frame);
