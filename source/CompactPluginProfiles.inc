void appendCompactPluginProfiles(StackPanel row){
 auto plugin=find(state.GetNamedArray(L"plugins"),devicePluginId);if(str(plugin,L"kind",L"mouse")!=L"mouse")return;
 auto caption=text(tr(L"配置"),13,true);caption.VerticalAlignment(VerticalAlignment::Center);row.Children().Append(caption);JsonArray choices;std::vector<std::wstring> names;for(auto const& v:state.GetNamedArray(L"deviceProfiles",JsonArray{})){auto p=v.GetObject();if(str(p,L"plugin")==devicePluginId){choices.Append(p);names.push_back(str(p,L"name"));}}
 names.push_back(tr(L"＋ 新建配置"));auto picker=combo(names,-1,105);picker.Width(130);picker.VerticalAlignment(VerticalAlignment::Center);picker.PlaceholderText(tr(L"选择配置"));onSelectionChanged(picker,[this,picker,choices](auto const&,auto const&){if(picker.SelectedIndex()<0)return;if(picker.SelectedIndex()==(int)choices.Size()){JsonObject device{nullptr};for(auto const& v:sceneDevices()){auto d=v.GetObject();if(str(d,L"plugin")==devicePluginId&&flag(d,L"connected")){if(device){notice(tr(L"同型号设备有多个，请从“我的设备”选择具体外设新建配置。"),true);return;}device=d;}}if(!device){notice(tr(L"请先连接设备。"),true);return;}deviceProfileDialog(device);return;}if(!pluginView||!pluginView.CoreWebView2())return;JsonObject message;put(message,L"type",std::wstring(L"hhub.profiles.select"));put(message,L"profile",str(choices.GetObjectAt(picker.SelectedIndex()),L"id"));pluginView.CoreWebView2().PostWebMessageAsJson(message.Stringify());});row.Children().Append(picker);
}
