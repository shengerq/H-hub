void eqSettingsPage(){if(!eqSettingsDraft)eqSettingsDraft=object(std::wstring(state.GetNamedObject(L"eqTemplate",JsonObject{}).Stringify()));auto config=object(std::wstring(eqSettingsDraft.Stringify()));auto body=stack(false,18);body.MaxWidth(680);body.HorizontalAlignment(HorizontalAlignment::Left);
