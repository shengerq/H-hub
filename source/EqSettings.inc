 auto actions=stack(true,12);actions.Children().Append(button(tr(L"保存并返回"),[this,values]()mutable{try{saveEqSettings(values());go(L"eq",true);}catch(hresult_error const& e){notice(std::wstring(e.message()),true);}},true));actions.Children().Append(button(tr(L"返回"),[this]{go(L"eq",true);}));body.Children().Append(actions);
 body.Children().Append(button(tr(L"恢复 FxSound 默认频率"),[this,values]()mutable{try{auto config=values();JsonArray frequencies,bands;for(double frequency:EqDsp::frequencies)frequencies.Append(JsonValue::CreateNumberValue(frequency));for(int i=1;i<=10;i++)bands.Append(JsonValue::CreateNumberValue(i));config.SetNamedValue(L"frequencies",frequencies);config.SetNamedValue(L"activeBands",bands);saveEqSettings(config);render();notice(tr(L"已恢复 FxSound 默认 10 段频率"));}catch(hresult_error const& e){notice(std::wstring(e.message()),true);}}));
