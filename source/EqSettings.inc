std::pair<double,double> eqBandBounds(int i,double=1){auto found=std::find(eqActive.begin(),eqActive.end(),i);if(found==eqActive.end())return {eqCenters[i],eqCenters[i]};auto bounds=fxFrequencyRange((int)eqActive.size(),(int)(found-eqActive.begin()),eqCenters[i]);return {std::min(bounds.first,eqCenters[i]),std::max(bounds.second,eqCenters[i])};}
double clampEqFrequency(int i,double value,double ratio=1){auto bounds=eqBandBounds(i,ratio);return std::clamp(value,bounds.first,bounds.second);}bool eqBandActive(int i)const{return std::find(eqActive.begin(),eqActive.end(),i)!=eqActive.end();}
void saveEqActive(JsonObject b){JsonArray list;for(int i:eqActive)list.Append(JsonValue::CreateNumberValue(i));b.SetNamedValue(L"activeBands",list);}

std::pair<double,double> eqSpectrum()const{return eqActive.size()==10||eqActive.size()==5?std::pair<double,double>{62.5,16000}:std::pair<double,double>{20,20000};}
