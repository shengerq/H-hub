// Included inside Model. Profile ownership is per concrete device, not model.
void migrateSceneConfigurations(){
 if(!state.HasKey(L"deviceProfiles"))state.SetNamedValue(L"deviceProfiles",JsonArray{});
 if(!state.HasKey(L"profileDevices"))state.SetNamedValue(L"profileDevices",JsonArray{});
 state.SetNamedValue(L"profileRuntime",JsonArray{});state.SetNamedValue(L"deviceProfileOverrides",JsonObject{});
 for(auto const& v:state.GetNamedArray(L"scenes")){auto s=v.GetObject();if(!s.HasKey(L"apps")){JsonArray apps;if(!str(s,L"app").empty())apps.Append(JsonValue::CreateStringValue(str(s,L"app")));s.SetNamedValue(L"apps",apps);}if(!s.HasKey(L"bindings"))s.SetNamedValue(L"bindings",JsonArray{});if(!s.HasKey(L"priority"))put(s,L"priority",0.0);}
}
bool sceneMatches(JsonObject s,std::wstring app){if(app.empty())return false;for(auto const& v:s.GetNamedArray(L"apps",JsonArray{}))if(CompareStringOrdinal(v.GetString().c_str(),-1,app.c_str(),-1,TRUE)==CSTR_EQUAL)return true;return CompareStringOrdinal(str(s,L"app").c_str(),-1,app.c_str(),-1,TRUE)==CSTR_EQUAL;}
void refreshProfileConnections(){for(auto const& v:state.GetNamedArray(L"profileRuntime",JsonArray{})){auto item=v.GetObject();try{auto p=find(state.GetNamedArray(L"deviceProfiles"),str(item,L"profile"));if(nativeProfileProvider(state,p))continue;auto d=find(state.GetNamedArray(L"profileDevices"),str(p,L"device"));bool connected=false;for(auto const& dev:state.GetNamedObject(L"detected",JsonObject{}).GetNamedArray(L"peripherals",JsonArray{}))if(str(dev.GetObject(),L"id")==str(d,L"id")&&flag(dev.GetObject(),L"connected",true))connected=true;bool changed=item.HasKey(L"wasConnected")&&flag(item,L"wasConnected")!=connected;put(item,L"wasConnected",connected);if(changed&&p.HasKey(L"payload")){put(item,L"state",std::wstring(L"waitingPlugin"));put(item,L"requestId",L"connection-"+std::to_wstring(GetTickCount64())+L"-"+str(p,L"id"));put(item,L"error",std::wstring());}}catch(...) {}}}
JsonObject matchingScene(std::wstring app){auto target=find(state.GetNamedArray(L"scenes"),L"desktop");bool matched=false;double priority=0;for(auto const& v:state.GetNamedArray(L"scenes")){auto s=v.GetObject();if(sceneMatches(s,app)&&(!matched||num(s,L"priority")>priority)){target=s;matched=true;priority=num(s,L"priority");}}return target;}
void requestSceneProfiles(JsonObject scene){
 JsonArray runtime;auto old=state.GetNamedArray(L"profileRuntime",JsonArray{});
 for(auto const& v:scene.GetNamedArray(L"bindings",JsonArray{})){auto binding=v.GetObject();try{auto selected=str(binding,L"profile");auto overrides=state.GetNamedObject(L"deviceProfileOverrides",JsonObject{});if(overrides.HasKey(str(binding,L"device")))selected=str(overrides,str(binding,L"device").c_str());auto profile=find(state.GetNamedArray(L"deviceProfiles"),selected);auto device=find(state.GetNamedArray(L"profileDevices"),str(profile,L"device"));JsonObject item;put(item,L"id",str(device,L"id"));put(item,L"profile",str(profile,L"id"));put(item,L"plugin",str(profile,L"plugin"));put(item,L"revision",num(profile,L"revision"));put(item,L"requestId",std::to_wstring(GetTickCount64())+L"-"+str(profile,L"id")+L"-"+std::to_wstring((int)num(profile,L"revision")));put(item,L"state",std::wstring(profilePendingState(state,profile).c_str()));
 for(auto const& previous:old){auto p=previous.GetObject();if(str(p,L"id")==str(item,L"id")&&str(p,L"profile")==str(item,L"profile")&&num(p,L"revision")==num(item,L"revision"))item=object(std::wstring(p.Stringify()));}
 runtime.Append(item);}catch(...) {}}
 state.SetNamedValue(L"profileRuntime",runtime);
}
void sceneConfigurationRequest(std::wstring op,JsonObject b){
 auto profiles=state.GetNamedArray(L"deviceProfiles");
 if(op==L"deviceProfileSave"){
  auto profile=object(std::wstring(b.GetNamedObject(L"profile").Stringify()));auto id=str(profile,L"id");if(id.empty()||str(profile,L"name").empty()||str(profile,L"name").size()>80)throw hresult_invalid_argument(L"请输入配置名称");auto device=b.GetNamedObject(L"device");if(str(device,L"id").empty()||str(profile,L"device")!=str(device,L"id"))throw hresult_invalid_argument(L"配置必须属于具体外设");
  auto plugin=str(profile,L"plugin");if(true){auto p=find(state.GetNamedArray(L"plugins"),plugin);if(!flag(p,L"installed"))throw hresult_invalid_argument(L"外设插件未安装");}
  bool replaced=false;for(uint32_t i=0;i<profiles.Size();i++){auto old=profiles.GetObjectAt(i);if(str(old,L"id")==id){if(str(old,L"device")!=str(profile,L"device")||str(old,L"plugin")!=plugin)throw hresult_invalid_argument(L"不能更改配置所属外设或插件");put(profile,L"revision",num(old,L"revision")+1);if(!profile.HasKey(L"payload")&&old.HasKey(L"payload"))profile.SetNamedValue(L"payload",old.GetNamedObject(L"payload"));profiles.SetAt(i,profile);replaced=true;break;}}if(!replaced){put(profile,L"revision",1.0);profiles.Append(profile);}auto devices=state.GetNamedArray(L"profileDevices");bool foundDevice=false;for(uint32_t i=0;i<devices.Size();i++)if(str(devices.GetObjectAt(i),L"id")==str(device,L"id")){devices.SetAt(i,device);foundDevice=true;break;}if(!foundDevice)devices.Append(device);
 }
 else if(op==L"deviceProfileDelete"){auto id=str(b,L"id");auto deleted=find(profiles,id);auto overrides=state.GetNamedObject(L"deviceProfileOverrides",JsonObject{});if(str(overrides,str(deleted,L"device").c_str())==id)overrides.Remove(str(deleted,L"device"));for(uint32_t i=profiles.Size();i>0;i--)if(str(profiles.GetObjectAt(i-1),L"id")==id)profiles.RemoveAt(i-1);for(auto const& v:state.GetNamedArray(L"scenes")){auto binds=v.GetObject().GetNamedArray(L"bindings");for(uint32_t i=binds.Size();i>0;i--)if(str(binds.GetObjectAt(i-1),L"profile")==id)binds.RemoveAt(i-1);}}
 else if(op==L"sceneBindProfile"){auto scene=find(state.GetNamedArray(L"scenes"),str(b,L"scene"));auto profile=find(profiles,str(b,L"profile"));auto binds=scene.GetNamedArray(L"bindings");JsonObject binding;put(binding,L"device",str(profile,L"device"));put(binding,L"profile",str(profile,L"id"));bool replaced=false;for(uint32_t i=0;i<binds.Size();i++)if(str(binds.GetObjectAt(i),L"device")==str(profile,L"device")){binds.SetAt(i,binding);replaced=true;break;}if(!replaced)binds.Append(binding);}
 else if(op==L"sceneUnbindProfile"){auto scene=find(state.GetNamedArray(L"scenes"),str(b,L"scene"));auto binds=scene.GetNamedArray(L"bindings");for(uint32_t i=binds.Size();i>0;i--)if(str(binds.GetObjectAt(i-1),L"device")==str(b,L"device"))binds.RemoveAt(i-1);}
 else if(op==L"deviceProfileCapture"){auto profile=find(profiles,str(b,L"profile"));if(str(profile,L"plugin")!=str(b,L"plugin"))throw hresult_invalid_argument(L"插件不能读取其他插件配置");auto plugin=find(state.GetNamedArray(L"plugins"),str(b,L"plugin"));if(!flag(plugin,L"installed")||flag(plugin,L"forceStopped")||str(plugin,L"mode")==L"disabled")throw hresult_invalid_argument(L"插件未启用");auto payload=b.GetNamedObject(L"payload");if(payload.Stringify().size()>2097152)throw hresult_invalid_argument(L"配置数据过大");profile.SetNamedValue(L"payload",payload);put(profile,L"revision",num(profile,L"revision")+1);}
 else if(op==L"deviceProfileRetry"){auto p=find(profiles,str(b,L"profile"));bool found=false;for(auto const& v:state.GetNamedArray(L"profileRuntime")){auto item=v.GetObject();if(str(item,L"profile")==str(p,L"id")){put(item,L"requestId",L"retry-"+std::to_wstring(GetTickCount64())+L"-"+str(p,L"id"));put(item,L"state",profilePendingState(state,p));put(item,L"error",std::wstring());found=true;}}if(!found)throw hresult_invalid_argument(L"该配置未绑定当前场景");return;}
 else if(op==L"deviceProfileAck"){auto profile=find(profiles,str(b,L"profile"));if(str(profile,L"plugin")!=str(b,L"plugin"))throw hresult_invalid_argument();auto plugin=find(state.GetNamedArray(L"plugins"),str(b,L"plugin"));if(!flag(plugin,L"installed")||flag(plugin,L"forceStopped")||str(plugin,L"mode")==L"disabled")throw hresult_invalid_argument(L"插件未启用");bool current=false;for(auto const& v:state.GetNamedArray(L"profileRuntime")){auto item=v.GetObject();if(str(item,L"requestId")==str(b,L"requestId")&&str(item,L"profile")==str(profile,L"id")){put(item,L"state",flag(b,L"confirmed")?std::wstring(L"confirmed"):std::wstring(L"failed"));put(item,L"error",str(b,L"error"));current=true;}}if(!current)throw hresult_invalid_argument(L"配置请求已过期");return;}
 else throw hresult_invalid_argument();
 requestSceneProfiles(find(state.GetNamedArray(L"scenes"),str(state,L"currentScene")));log(L"场景与外设配置已保存");
}
