ComboBox catalogCheckCombo(DependencyObject root,std::wstring tag){
 ComboBox found{nullptr};std::function<void(DependencyObject)> visit=[&](DependencyObject node){if(found)return;if(auto combo=node.try_as<ComboBox>();combo&&unbox_value_or<hstring>(combo.Tag(),hstring{})==tag){found=combo;return;}for(int i=0;i<VisualTreeHelper::GetChildrenCount(node);i++)visit(VisualTreeHelper::GetChild(node,i));};visit(root);if(!found)throw hresult_error(E_FAIL,L"Missing catalog selector: "+tag);return found;
}
