test(L"Fresh installs contain no native plugin registration or runtime",[&]{
 Model m({},false);ensure(!pluginInstalled(m.state,L"eq")&&!pluginInstalled(m.state,L"phone"));ensure(m.state.GetNamedArray(L"plugins").Size()==0);ensure(!flag(m.state.GetNamedObject(L"settings"),L"eqEnabled")&&!flag(m.state.GetNamedObject(L"settings"),L"phoneEnabled"));ensure(m.state.GetNamedArray(L"presets").Size()==0);EqAudio audio;auto snapshot=audio.snapshot(m.state);ensure(snapshot.GetNamedArray(L"outputs").Size()==0&&!snapshot.HasKey(L"driverReady"));
});
test(L"Native uninstall removes configurations and never resurrects after reload",[&]{
 for(auto id:{L"eq",L"phone"}){
  auto file=report.parent_path()/(std::wstring(L"native-uninstall-")+id+L".json");Model m(file,false);auto manifest=object(read(nativeTestPackage(id==std::wstring(L"eq")?L"Hhub-EQ-1.0.3.hhub":L"Hhub-Phone-Remote-1.0.9.hhub")));JsonObject b;b.SetNamedValue(L"manifest",manifest);JsonObject req;put(req,L"op",std::wstring(L"importPlugin"));req.SetNamedValue(L"body",b);m.request(req);ensure(pluginInstalled(m.state,id));ensure(!flag(m.state.GetNamedObject(L"settings"),id==std::wstring(L"eq")?L"eqEnabled":L"phoneEnabled"));
  if(id==std::wstring(L"eq")){m.state.SetNamedValue(L"eqTemplate",object(LR"({"preset":"custom","secret":"old-curve"})"));m.state.SetNamedValue(L"deviceProfiles",JsonArray::Parse(LR"([{"id":"eq-profile","kind":"audio","provider":"generic","device":"audio-output:old"},{"id":"keyboard-kept","kind":"keyboard","device":"keyboard"}])"));m.state.SetNamedValue(L"profileDevices",JsonArray::Parse(LR"([{"id":"audio-output:old"},{"id":"keyboard"}])"));find(m.state.GetNamedArray(L"scenes"),L"desktop").SetNamedValue(L"bindings",JsonArray::Parse(LR"([{"profile":"eq-profile"},{"profile":"keyboard-kept"}])"));}
  else {m.state.SetNamedValue(L"phones",JsonArray::Parse(LR"([{"id":"old-peer","token":"old-token"}])"));put(m.state,L"pairCode",std::wstring(L"old-pin"));}
  m.request(object(std::wstring(L"{\"op\":\"pluginRemove\",\"body\":{\"id\":\"")+id+L"\"}}"));ensure(!pluginRecord(m.state,id));m.persistent=true;m.save();auto saved=object(read(file));ensure(!saved.HasKey(id==std::wstring(L"eq")?L"eqTemplate":L"phones"));Model loaded(file,true);ensure(!pluginRecord(loaded.state,id));if(id==std::wstring(L"eq")){ensure(loaded.state.GetNamedArray(L"presets").Size()==0);ensure(loaded.state.GetNamedArray(L"deviceProfiles").Size()==1);ensure(loaded.state.GetNamedArray(L"profileDevices").Size()==1);ensure(find(loaded.state.GetNamedArray(L"scenes"),L"desktop").GetNamedArray(L"bindings").Size()==1);}else ensure(!loaded.state.HasKey(L"pairCode"));std::filesystem::remove(file);
 }
});
test(L"Replacing a native package preserves saved curves and enable preference",[&]{
 Model m({},false);auto manifest=object(read(nativeTestPackage(L"Hhub-EQ-1.0.3.hhub")));JsonObject b;b.SetNamedValue(L"manifest",manifest);JsonObject req;put(req,L"op",std::wstring(L"importPlugin"));req.SetNamedValue(L"body",b);m.request(req);m.state.SetNamedValue(L"eqTemplate",object(LR"({"preset":"custom","preamp":-3})"));put(m.state.GetNamedObject(L"settings"),L"eqEnabled",false);put(manifest,L"version",std::wstring(L"1.0.4"));put(b,L"replaceInstalled",true);m.request(req);ensure(num(m.state.GetNamedObject(L"eqTemplate"),L"preamp")==-3&&!flag(m.state.GetNamedObject(L"settings"),L"eqEnabled"));
});
test(L"Legacy forced EQ registration is removed instead of silently reinstalled",[&]{
 auto file=report.parent_path()/L"legacy-native-forced.json";auto saved=object(initialState);saved.SetNamedValue(L"plugins",JsonArray::Parse(LR"([{"id":"eq","author":"H hub","installed":true,"version":"1.0.3"}])"));saved.SetNamedValue(L"eqTemplate",object(LR"({"preset":"custom"})"));write(file,std::wstring(saved.Stringify()));Model m(file,true);ensure(!pluginRecord(m.state,L"eq")&&!m.state.HasKey(L"eqTemplate"));m.save();Model again(file,true);ensure(!pluginRecord(again.state,L"eq"));std::filesystem::remove(file);
});

