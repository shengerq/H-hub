void appendPluginContributions(std::wstring const& slot){for(auto const& v:state.GetNamedArray(L"plugins")){auto plugin=v.GetObject();if(!integrationEnabled(plugin))continue;for(auto const& item:plugin.GetNamedArray(L"pageContributions",JsonArray{})){auto declaration=item.GetObject();if(str(declaration,L"slot")!=slot)continue;auto contribution=std::make_shared<PageContribution>();contribution->host=Border{};contribution->host.Height(std::clamp(num(declaration,L"height",320),100.0,1200.0));page.Children().Append(contribution->host);try{JsonObject initial,context;put(initial,L"dark",dark);initial.SetNamedValue(L"state",state);put(context,L"entry",str(declaration,L"entry"));put(context,L"embedded",true);put(context,L"scene",sceneTargetId);initial.SetNamedValue(L"context",context);contribution->surface=std::make_unique<NativePluginPage>();contribution->surface->create(hwnd,initial,winrt::get_unknown(contribution->host),str(plugin,L"id"));pageContributions.push_back(contribution);onLayoutUpdated(contribution->host,[this,weak=std::weak_ptr<PageContribution>(contribution)](auto const&,auto const&){if(auto c=weak.lock())positionPageContribution(c);});}catch(hresult_error const& e){contribution->host.Child(text(std::wstring(e.message()),12,true));}}}}
template<class Add>void appendProjectedPluginDevices(Add add){for(auto const& v:state.GetNamedArray(L"plugins")){auto plugin=v.GetObject();if(!integrationEnabled(plugin)||!plugin.HasKey(L"deviceProjection"))continue;auto declaration=plugin.GetNamedObject(L"deviceProjection");IJsonValue node=state;for(auto const& step:declaration.GetNamedArray(L"statePath",JsonArray{})){if(node.ValueType()!=JsonValueType::Object){node=JsonValue::CreateNullValue();break;}node=node.GetObject().GetNamedValue(step.GetString(),JsonValue::CreateNullValue());}if(node.ValueType()!=JsonValueType::Array)continue;for(auto const& item:node.GetArray()){auto value=item.GetObject();JsonObject device;put(device,L"id",str(declaration,L"idPrefix")+str(value,L"id"));put(device,L"name",str(value,L"name"));put(device,L"plugin",str(plugin,L"id"));put(device,L"kind",str(declaration,L"kind",L"peripheral"));put(device,L"connected",true);auto field=str(declaration,L"copyIdAs");if(!field.empty())put(device,field.c_str(),str(value,L"id"));add(device);}}}
