void exportNativeEqPreview(std::filesystem::path file,bool composed=false){if(!nativeEq||!nativeEq->window)return;auto h=nativeEq->window;RECT r{};GetClientRect(h,&r);if(r.right<2||r.bottom<2)return;struct Snapshot{HDC dc{};HBITMAP bitmap{},old{};~Snapshot(){if(dc){SelectObject(dc,old);DeleteDC(dc);}if(bitmap)DeleteObject(bitmap);}} capture;capture.dc=CreateCompatibleDC(nullptr);BITMAPINFO info{};info.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);info.bmiHeader.biWidth=r.right;info.bmiHeader.biHeight=-r.bottom;info.bmiHeader.biPlanes=1;info.bmiHeader.biBitCount=32;void* pixels{};capture.bitmap=CreateDIBSection(capture.dc,&info,DIB_RGB_COLORS,&pixels,nullptr,0);check_bool(capture.bitmap!=nullptr);capture.old=(HBITMAP)SelectObject(capture.dc,capture.bitmap);if(composed){POINT point{};ClientToScreen(h,&point);auto screen=GetDC(nullptr);BitBlt(capture.dc,0,0,r.right,r.bottom,screen,point.x,point.y,SRCCOPY|CAPTUREBLT);ReleaseDC(nullptr,screen);}else SendMessageW(h,WM_PRINT,(WPARAM)capture.dc,PRF_CLIENT|PRF_CHILDREN);auto bytes=(unsigned char*)pixels;for(size_t i=0;i<(size_t)r.right*r.bottom;i++)bytes[i*4+3]=255;std::filesystem::create_directories(file.parent_path());winrt::com_ptr<IWICImagingFactory> factory;check_hresult(CoCreateInstance(CLSID_WICImagingFactory,nullptr,CLSCTX_INPROC_SERVER,__uuidof(IWICImagingFactory),factory.put_void()));winrt::com_ptr<IWICStream> stream;check_hresult(factory->CreateStream(stream.put()));check_hresult(stream->InitializeFromFilename(file.c_str(),GENERIC_WRITE));winrt::com_ptr<IWICBitmapEncoder> encoder;check_hresult(factory->CreateEncoder(GUID_ContainerFormatPng,nullptr,encoder.put()));check_hresult(encoder->Initialize(stream.get(),WICBitmapEncoderNoCache));winrt::com_ptr<IWICBitmapFrameEncode> frame;winrt::com_ptr<IPropertyBag2> props;check_hresult(encoder->CreateNewFrame(frame.put(),props.put()));check_hresult(frame->Initialize(props.get()));check_hresult(frame->SetSize(r.right,r.bottom));GUID format=GUID_WICPixelFormat32bppBGRA;check_hresult(frame->SetPixelFormat(&format));check_hresult(frame->WritePixels(r.bottom,r.right*4,r.right*r.bottom*4,bytes));check_hresult(frame->Commit());check_hresult(encoder->Commit());}
