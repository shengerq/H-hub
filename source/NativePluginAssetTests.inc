test(L"Native package components install independently without retaining binary data in state",[&]{
 wchar_t packageRoot[32768]{};GetEnvironmentVariableW(L"HHUB_NATIVE_COMPONENT_PACKAGES",packageRoot,32768);ensure(packageRoot[0]);auto root=report.parent_path()/L"native-assets-roundtrip";
 for(auto name:{L"Hhub-Windows-Settings-1.0.10.hhub",L"Hhub-Phone-Remote-1.0.10.hhub",L"Hhub-EQ-1.0.4.hhub"}){
  auto manifest=object(read(std::filesystem::path(packageRoot)/name));auto id=str(manifest,L"id");Model m(root/L"state.json",true);JsonObject body,request;body.SetNamedValue(L"manifest",manifest);put(body,L"replaceInstalled",true);put(request,L"op",std::wstring(L"importPlugin"));request.SetNamedValue(L"body",body);m.request(request);
  auto p=pluginRecord(m.state,id);ensure(p&&flag(p,L"installed"));for(auto const& value:p.GetNamedArray(L"nativeAssets")){auto meta=value.GetObject();ensure(!meta.HasKey(L"data"));auto path=nativeComponentPath(id,str(meta,L"path"),{},root);ensure(std::filesystem::is_regular_file(path));std::ifstream input(path,std::ios::binary);std::vector<unsigned char> bytes((std::istreambuf_iterator<char>(input)),{});ensure(nativeAssetDigest(bytes)==str(meta,L"sha256"));}
  ensure(std::filesystem::file_size(root/L"state.json")<128*1024);m.request(object(L"{\"op\":\"pluginRemove\",\"body\":{\"id\":\""+id+L"\"}}"));ensure(!std::filesystem::exists(root/L"native-components"/id));
 }
 ensure(!std::filesystem::exists(root/L"native-components"));std::filesystem::remove(root/L"state.json");std::filesystem::remove(root);
});
test(L"Native component tampering and path traversal never overwrite a valid installed worker",[&]{
 wchar_t packageRoot[32768]{};GetEnvironmentVariableW(L"HHUB_NATIVE_COMPONENT_PACKAGES",packageRoot,32768);auto manifest=object(read(std::filesystem::path(packageRoot)/L"Hhub-Windows-Settings-1.0.10.hhub"));auto root=report.parent_path()/L"native-assets-tampering";auto valid=object(std::wstring(manifest.Stringify()));auto transaction=installNativePluginAssets(valid,root);transaction->committed=true;transaction.reset();auto installed=root/L"native-components"/L"windows"/L"Hhub.Windows.exe";auto originalSize=std::filesystem::file_size(installed);
 auto deny=[&](JsonObject p){bool rejected=false;try{installNativePluginAssets(p,root);}catch(...){rejected=true;}ensure(rejected&&std::filesystem::file_size(installed)==originalSize);};
 auto bad=object(std::wstring(manifest.Stringify()));put(bad.GetNamedArray(L"nativeAssets").GetObjectAt(0),L"path",std::wstring(L"../Hhub.exe"));deny(bad);
 bad=object(std::wstring(manifest.Stringify()));auto asset=bad.GetNamedArray(L"nativeAssets").GetObjectAt(0);auto data=str(asset,L"data");data[0]=data[0]==L'A'?L'B':L'A';put(asset,L"data",data);deny(bad);
 bad=object(std::wstring(manifest.Stringify()));put(bad.GetNamedObject(L"requiredHost"),L"apiVersion",std::wstring(L"1.0"));deny(bad);
 removeNativePluginAssets(root,L"windows");std::filesystem::remove(root);
});
test(L"An interrupted native component import restores the previous component",[&]{
 wchar_t packageRoot[32768]{};GetEnvironmentVariableW(L"HHUB_NATIVE_COMPONENT_PACKAGES",packageRoot,32768);auto manifest=object(read(std::filesystem::path(packageRoot)/L"Hhub-Windows-Settings-1.0.10.hhub"));auto root=report.parent_path()/L"native-assets-rollback";auto file=root/L"native-components"/L"windows"/L"Hhub.Windows.exe";write(file,L"previous component fixture");{auto transaction=installNativePluginAssets(manifest,root);ensure(std::filesystem::file_size(file)>1000000);}ensure(read(file)==L"previous component fixture");removeNativePluginAssets(root,L"windows");std::filesystem::remove(root);
});

test(L"Native updates expose only metadata and install verified components without changing preferences",[&]{
 wchar_t packageRoot[32768]{};GetEnvironmentVariableW(L"HHUB_NATIVE_COMPONENT_PACKAGES",packageRoot,32768);auto manifest=object(read(std::filesystem::path(packageRoot)/L"Hhub-Windows-Settings-1.0.10.hhub"));auto root=report.parent_path()/L"native-assets-update";auto previous=object(std::wstring(manifest.Stringify()));previous.Remove(L"nativeAssets");put(previous,L"installed",true);put(previous,L"mode",std::wstring(L"manual"));put(previous,L"version",std::wstring(L"1.0.9"));Model m({},false);m.state.GetNamedArray(L"plugins").Append(previous);
 Updates updates;updates.report=root/L"result.json";JsonObject result,item;JsonArray items;put(item,L"id",std::wstring(L"windows"));put(item,L"ready",true);item.SetNamedValue(L"manifest",manifest);items.Append(item);result.SetNamedValue(L"plugins",items);write(updates.report,std::wstring(result.Stringify()));auto view=updates.snapshot(m.state);ensure(view.Stringify().size()<128*1024);ensure(!view.GetNamedArray(L"plugins").GetObjectAt(0).GetNamedObject(L"manifest").GetNamedArray(L"nativeAssets").GetObjectAt(0).HasKey(L"data"));updates.applyPlugin(m.state,L"windows");auto installed=pluginRecord(m.state,L"windows");ensure(str(installed,L"version")==L"1.0.10"&&str(installed,L"mode")==L"manual"&&flag(installed,L"installed"));ensure(!installed.GetNamedArray(L"nativeAssets").GetObjectAt(0).HasKey(L"data"));ensure(std::filesystem::is_regular_file(nativeComponentPath(L"windows",L"Hhub.Windows.exe")));removeNativePluginAssets(dataDir(),L"windows");std::filesystem::remove(updates.report);std::filesystem::remove(root);
});
