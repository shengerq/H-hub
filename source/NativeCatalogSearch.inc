void positionNativeCatalogSearch(){if(!nativeCatalogSearch||!catalogSearch||!catalogSearch.IsLoaded()||!shell)return;if(hasOpenDialog()){ShowWindow(nativeCatalogSearch->window,SW_HIDE);return;}double dpi=GetDpiForWindow(hwnd)/96.0;auto point=catalogSearch.TransformToVisual(shell).TransformPoint({0,0});RECT r{(LONG)std::lround(point.X*dpi)+1,(LONG)std::lround(point.Y*dpi)+1,(LONG)std::lround(catalogSearch.ActualWidth()*dpi)-2,(LONG)std::lround(catalogSearch.ActualHeight()*dpi)-2};if(r.right<1||r.bottom<1)return;auto origin=pageScroll.TransformToVisual(shell).TransformPoint({0,0});RECT frame{r.left,r.top,r.left+r.right,r.top+r.bottom},viewport{(LONG)(origin.X*dpi),(LONG)(origin.Y*dpi),(LONG)((origin.X+pageScroll.ViewportWidth())*dpi),(LONG)((origin.Y+pageScroll.ViewportHeight())*dpi)},visible{};if(nav.IsPaneOpen()&&nav.DisplayMode()!=NavigationViewDisplayMode::Expanded)viewport.left=std::max<LONG>(viewport.left,(LONG)std::lround(nav.OpenPaneLength()*dpi));if(!IntersectRect(&visible,&frame,&viewport)){ShowWindow(nativeCatalogSearch->window,SW_HIDE);return;}bool moved=!EqualRect(&r,&catalogSearchRect);if(moved){catalogSearchRect=r;SetWindowPos(nativeCatalogSearch->window,HWND_TOP,r.left,r.top,r.right,r.bottom,SWP_NOACTIVATE|SWP_SHOWWINDOW);}else if(!IsWindowVisible(nativeCatalogSearch->window))ShowWindow(nativeCatalogSearch->window,SW_SHOWNOACTIVATE);OffsetRect(&visible,-r.left,-r.top);if(moved||!EqualRect(&visible,&catalogSearchClip)){catalogSearchClip=visible;auto region=CreateRectRgnIndirect(&visible);if(!SetWindowRgn(nativeCatalogSearch->window,region,TRUE))DeleteObject(region);}}
