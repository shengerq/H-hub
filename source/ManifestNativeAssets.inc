#pragma comment(lib,"bcrypt.lib")
#pragma comment(lib,"crypt32.lib")
// Installed manifests provide component names and hashes. No per-plugin host pins.
struct NativeAssetDefinition{std::wstring name,hash;};
inline bool validPluginId(std::wstring const& id){return !id.empty()&&id.size()<=80&&id.front()!=L'.'&&id.back()!=L'.'&&std::all_of(id.begin(),id.end(),[](wchar_t c){return (c>=L'a'&&c<=L'z')||(c>=L'0'&&c<=L'9')||c==L'.'||c==L'-'||c==L'_';})&&id.find(L"..") == std::wstring::npos;}
inline bool validAssetName(std::wstring const& name){if(name.empty()||name.size()>180||name.find(L'\\')!=std::wstring::npos||name.find(L':')!=std::wstring::npos||name.front()==L'/'||name.back()==L'/')return false;for(auto const& part:std::filesystem::path(name)){auto s=part.wstring();if(s.empty()||s==L"."||s==L".."||s.back()==L'.'||s.back()==L' '||s.find_first_of(L"<>\"|?*")!=std::wstring::npos)return false;auto stem=std::filesystem::path(s).stem().wstring();std::transform(stem.begin(),stem.end(),stem.begin(),towupper);if(stem==L"CON"||stem==L"PRN"||stem==L"AUX"||stem==L"NUL"||(stem.size()==4&&(stem.rfind(L"COM",0)==0||stem.rfind(L"LPT",0)==0)&&stem[3]>=L'0'&&stem[3]<=L'9'))return false;}return true;}
inline std::map<std::wstring,JsonObject>& installedNativeManifests(){static std::map<std::wstring,JsonObject> records;return records;}
inline void registerNativeManifests(JsonObject state){auto& records=installedNativeManifests();records.clear();for(auto const& value:state.GetNamedArray(L"plugins",JsonArray{})){auto plugin=value.GetObject();if(flag(plugin,L"installed")&&plugin.HasKey(L"nativeAssets"))records[str(plugin,L"id")]=plugin;}}
inline JsonObject nativeManifest(std::wstring const& id){if(!validPluginId(id))throw hresult_invalid_argument(L"插件 ID 无效");auto& records=installedNativeManifests();auto it=records.find(id);if(it!=records.end())return it->second;try{auto p=pluginRecord(object(read(dataDir()/L"state.json")),id);if(p&&flag(p,L"installed")){records.emplace(id,p);return p;}}catch(...){}return JsonObject{};}
inline std::vector<NativeAssetDefinition> nativeAssetDefinitions(std::wstring const& id){std::vector<NativeAssetDefinition> result;for(auto const& v:nativeManifest(id).GetNamedArray(L"nativeAssets",JsonArray{})){auto item=v.GetObject();if(validAssetName(str(item,L"path")))result.push_back({str(item,L"path"),str(item,L"sha256")});}return result;}
inline bool nativeAssetHashApproved(std::wstring const&,NativeAssetDefinition const& definition,std::wstring const& hash){return definition.hash==hash;}
inline std::wstring nativeAssetDigest(std::vector<unsigned char> const& bytes){BCRYPT_ALG_HANDLE algorithm{};if(BCryptOpenAlgorithmProvider(&algorithm,BCRYPT_SHA256_ALGORITHM,nullptr,0)<0)throw hresult_error(E_FAIL);unsigned char hash[32]{};auto status=BCryptHash(algorithm,nullptr,0,const_cast<PUCHAR>(bytes.data()),(ULONG)bytes.size(),hash,32);BCryptCloseAlgorithmProvider(algorithm,0);if(status<0)throw hresult_error(E_FAIL);std::wstring text;for(auto byte:hash){wchar_t part[3]{};swprintf_s(part,L"%02x",byte);text+=part;}return text;}
inline bool hostVersionSupports(std::wstring const& minimum,unsigned epoch=0){if(minimum.empty())return true;unsigned parts[4]{};size_t start=0;for(unsigned i=0;i<4;i++){auto end=minimum.find(L'.',start);auto part=minimum.substr(start,end==std::wstring::npos?end:end-start);if(part.empty()||part.size()>5||!std::all_of(part.begin(),part.end(),[](wchar_t c){return c>=L'0'&&c<=L'9';}))return false;parts[i]=(unsigned)std::stoul(part);if(end==std::wstring::npos){start=minimum.size();break;}start=end+1;if(i==3)return false;}// Epoch 0 packages target the historical host numbering; API 1.3 retains that compatibility.
 unsigned host[]{1,0,0,0};if(epoch==0){host[1]=5;}else if(epoch>1)return false;for(unsigned i=0;i<4;i++){if(parts[i]<host[i])return true;if(parts[i]>host[i])return false;}return true;}
inline bool nativeNoLinks(std::filesystem::path path){for(;!path.empty();path=path.parent_path()){auto attr=GetFileAttributesW(path.c_str());if(attr!=INVALID_FILE_ATTRIBUTES&&(attr&FILE_ATTRIBUTE_REPARSE_POINT))return false;if(path==path.parent_path())break;}return true;}
inline void verifyNativeAssets(std::wstring const& id){auto folder=dataDir()/L"native-components"/id;for(auto const& asset:nativeAssetDefinitions(id)){auto path=folder/asset.name;if(!nativeNoLinks(path)||!std::filesystem::is_regular_file(path)||std::filesystem::file_size(path)>4*1024*1024)throw hresult_error(E_ACCESSDENIED,L"插件组件路径或大小无效");std::ifstream input(path,std::ios::binary);std::vector<unsigned char> bytes((std::istreambuf_iterator<char>(input)),{});if(nativeAssetDigest(bytes)!=asset.hash)throw hresult_error(E_ACCESSDENIED,L"插件组件摘要校验失败");}}
inline void clearNativeAssetFolder(std::filesystem::path const& folder,std::wstring const& id){if(!validPluginId(id)||!nativeNoLinks(folder)||folder.parent_path().filename()!=L"native-components"||folder.filename().wstring().rfind(id,0)!=0)throw hresult_error(E_ACCESSDENIED,L"插件目录无效");if(std::filesystem::exists(folder))for(auto const& entry:std::filesystem::recursive_directory_iterator(folder)){auto attributes=GetFileAttributesW(entry.path().c_str());if(attributes!=INVALID_FILE_ATTRIBUTES&&(attributes&FILE_ATTRIBUTE_REPARSE_POINT))throw hresult_error(E_ACCESSDENIED,L"插件目录包含链接，已停止清理");}std::error_code ec;std::filesystem::remove_all(folder,ec);if(ec)throw hresult_error(E_FAIL,L"插件组件仍在使用，清理未完成");}
struct NativeAssetTransaction{
 std::filesystem::path destination,staging,backup;std::wstring id;bool activated=false,committed=false;
 NativeAssetTransaction(std::filesystem::path root,std::wstring plugin):id(plugin){auto base=root/L"native-components";if(!validPluginId(id)||!nativeNoLinks(base))throw hresult_invalid_argument();std::filesystem::create_directories(base);destination=base/id;auto suffix=std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(GetTickCount64());staging=base/(id+L".install-"+suffix);backup=base/(id+L".previous-"+suffix);if(!nativeNoLinks(destination))throw hresult_invalid_argument();std::filesystem::create_directory(staging);}
 ~NativeAssetTransaction(){try{if(activated&&!committed){clearNativeAssetFolder(destination,id);if(std::filesystem::exists(backup))std::filesystem::rename(backup,destination);}if(std::filesystem::exists(staging))clearNativeAssetFolder(staging,id);if(committed&&std::filesystem::exists(backup))clearNativeAssetFolder(backup,id);}catch(...) {}}
 void activate(){if(std::filesystem::exists(destination))std::filesystem::rename(destination,backup);try{std::filesystem::rename(staging,destination);activated=true;}catch(...){if(std::filesystem::exists(backup))std::filesystem::rename(backup,destination);throw;}}
};
inline std::unique_ptr<NativeAssetTransaction> installNativePluginAssets(JsonObject plugin,std::filesystem::path root={}){
 if(!plugin.HasKey(L"nativeAssets"))return {};
 if(!hostVersionSupports(str(plugin.GetNamedObject(L"requiredHost",JsonObject{}),L"minimumVersion"),(unsigned)num(plugin.GetNamedObject(L"requiredHost",JsonObject{}),L"releaseEpoch")))throw hresult_invalid_argument(L"插件需要更新版本的主程序");auto id=str(plugin,L"id");auto assets=plugin.GetNamedArray(L"nativeAssets");auto api=str(plugin.GetNamedObject(L"requiredHost",JsonObject{}),L"apiVersion");if(!validPluginId(id)||!assets.Size()||assets.Size()>64||(api!=L"1.1"&&api!=L"1.2"&&api!=L"1.3"&&api!=L"1.4"))throw hresult_invalid_argument(L"原生插件组件数量或宿主契约无效");
 struct Decoded{std::wstring name;std::vector<unsigned char> bytes;};std::vector<Decoded> decoded;JsonArray metadata;size_t total=0;
 for(auto const& value:assets){auto item=value.GetObject();auto name=str(item,L"path"),hash=str(item,L"sha256"),data=str(item,L"data");auto folded=name;std::transform(folded.begin(),folded.end(),folded.begin(),towlower);if(!validAssetName(name)||hash.size()!=64||!std::all_of(hash.begin(),hash.end(),[](wchar_t c){return (c>=L'0'&&c<=L'9')||(c>=L'a'&&c<=L'f');})||std::any_of(decoded.begin(),decoded.end(),[&](auto const& d){auto n=d.name;std::transform(n.begin(),n.end(),n.begin(),towlower);return n==folded;}))throw hresult_invalid_argument(L"插件组件路径、摘要或重复项无效");
  if(data.empty()||data.size()>6*1024*1024||str(item,L"encoding")!=L"base64")throw hresult_invalid_argument(L"插件组件编码或大小无效");DWORD size{};if(!CryptStringToBinaryW(data.c_str(),(DWORD)data.size(),CRYPT_STRING_BASE64|CRYPT_STRING_STRICT,nullptr,&size,nullptr,nullptr)||size>4*1024*1024||(total+=size)>8*1024*1024)throw hresult_invalid_argument(L"插件组件无法解码");Decoded file{name,std::vector<unsigned char>(size)};if(!CryptStringToBinaryW(data.c_str(),(DWORD)data.size(),CRYPT_STRING_BASE64|CRYPT_STRING_STRICT,file.bytes.data(),&size,nullptr,nullptr)||nativeAssetDigest(file.bytes)!=hash)throw hresult_invalid_argument(L"插件组件 SHA-256 校验失败");
  JsonObject meta;put(meta,L"path",name);put(meta,L"sha256",hash);put(meta,L"bytes",(double)size);metadata.Append(meta);decoded.push_back(std::move(file));
 }
 auto implementation=plugin.GetNamedObject(L"implementation",JsonObject{});auto library=str(implementation,L"library");if(str(implementation,L"type")==L"native-module"&&(num(implementation,L"abiVersion")!=1||!validAssetName(library)||std::filesystem::path(library).extension()!=L".dll"||std::none_of(decoded.begin(),decoded.end(),[&](auto const& d){return d.name==library;})))throw hresult_invalid_argument(L"插件入口或 ABI 不受支持");
 std::unique_ptr<NativeAssetTransaction> transaction;if(!root.empty()){transaction=std::make_unique<NativeAssetTransaction>(root,id);for(auto const& file:decoded){auto path=transaction->staging/file.name;std::filesystem::create_directories(path.parent_path());std::ofstream output(path,std::ios::binary);output.write((char const*)file.bytes.data(),file.bytes.size());if(!output)throw hresult_error(E_FAIL,L"无法写入插件组件");}transaction->activate();}
 plugin.SetNamedValue(L"nativeAssets",metadata);return transaction;
}
inline void removeNativePluginAssets(std::filesystem::path root,std::wstring const& id){if(!validPluginId(id))throw hresult_invalid_argument();clearNativeAssetFolder(root/L"native-components"/id,id);installedNativeManifests().erase(id);auto folder=root/L"native-components";if(std::filesystem::exists(folder)&&std::filesystem::is_empty(folder))std::filesystem::remove(folder);}
